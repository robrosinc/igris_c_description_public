<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igris_c_lowerarm_module">
  <!-- Mesh path prefix for end-effector STL files (reused across all variants). -->
  <xacro:property name="mesh_prefix" value="package://igris_c_description/meshes/igris_c_end_effector"/>
  <xacro:property name="end_effector_value" value="$(arg end_effector)"/>
  <xacro:macro name="igris_no_end_effector" params="side"/>
  <xacro:macro name="igris_dummy_end_effector" params="side">
    <link name="${'l_hand_dummy' if side == 'Left' else 'r_hand_dummy'}">
      <inertial>
        <xacro:if value="${side == 'Left'}">
          <mass value="0.150"/>
          <origin xyz="0.00910 0.00371 0.07839"/>
          <inertia ixx="0.00081" ixy="-0.00004" ixz="0.00012" iyy="0.00117" iyz="0.00005" izz="0.00042"/>
        </xacro:if>
        <xacro:unless value="${side == 'Left'}">
          <mass value="0.150"/>
          <origin xyz="0.00910 -0.00371 0.07839"/>
          <inertia ixx="0.00081" ixy="0.00004" ixz="0.00012" iyy="0.00117" iyz="-0.00005" izz="0.00042"/>
        </xacro:unless>
      </inertial>
      <visual>
        <origin xyz="${'0 0.005 0.0365' if side == 'Left' else '0 -0.005 0.0365'}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${'0 0.005 0.0365' if side == 'Left' else '0 -0.005 0.0365'}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="${'l_hand' if side == 'Left' else 'r_hand'}" type="fixed">
      <parent link="${side == 'Left' and 'l_forearm' or 'r_forearm'}"/>
      <child link="${'l_hand_dummy' if side == 'Left' else 'r_hand_dummy'}"/>
      <xacro:if value="${side == 'Left'}">
        <origin xyz="0 0.0059 -0.2635" rpy="3.14 0 0"/>
      </xacro:if>
      <xacro:unless value="${side == 'Left'}">
        <origin xyz="0 -0.0059 -0.2635" rpy="3.14 0 0"/>
      </xacro:unless>
    </joint>
  </xacro:macro>
  <!-- Inertial values and mesh come from origin/feature/end-effector-hook (4c49fc0), where
       they are split across two hook+magnet combination macros; the parent link and the
       wrist_version z offset are this tree's, NOT the branch's l_wrist_connector / -0.024.
       NOTE the right part is the left rotated 180 deg about Z, NOT mirrored about y like the
       rest of this file. That is why x flips as well as y in the inertial origin and in the
       camera position, and why iyz flips sign. Verified against the two STLs: identical volume,
       R == Rz180(L) exactly. Do not "correct" these to the y-mirror rule. -->
  <xacro:macro name="igris_magnet_end_effector" params="side">
    <link name="${'l_magnet' if side == 'Left' else 'r_magnet'}">
      <inertial>
        <xacro:if value="${side == 'Left'}">
          <mass value="0.427"/>
          <origin xyz="0.00006 0.00281 -0.06784"/>
          <inertia ixx="0.00074" ixy="0.00000" ixz="0.00000" iyy="0.00034" iyz="-0.00005" izz="0.00057"/>
        </xacro:if>
        <xacro:unless value="${side == 'Left'}">
          <mass value="0.427"/>
          <origin xyz="-0.00006 -0.00281 -0.06784"/>
          <inertia ixx="0.00074" ixy="0.00000" ixz="0.00000" iyy="0.00034" iyz="0.00005" izz="0.00057"/>
        </xacro:unless>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/magnet/${'l_magnet_gripper' if side == 'Left' else 'r_magnet_gripper'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/magnet/${'l_magnet_gripper' if side == 'Left' else 'r_magnet_gripper'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="${'l_magnet' if side == 'Left' else 'r_magnet'}" type="fixed">
      <parent link="${'l_wrist_mount' if side == 'Left' else 'r_wrist_mount'}"/>
      <child link="${'l_magnet' if side == 'Left' else 'r_magnet'}"/>
      <origin xyz="0 0 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" rpy="0 0 0"/>
    </joint>
    <!-- Camera link: ROS OPTICAL frame (+Z forward, +X right, +Y down), the convention ROS
         publishes camera data in. The MuJoCo <camera> of the same name sits inside the matching
         <frame> and carries quat="0 1 0 0" (180 deg about X); that roll is the ONLY difference
         between the two conventions, since MuJoCo looks along -Z with +Y up.
         The hand, magnet and 1dof blocks all declare this name: end_effector selects exactly
         one, so one link of it exists per expansion. It is the frame of the single
         sensor/left_hand | sensor/right_hand stream, which igris_c_camera publishes from the
         /dev/left_hand | /dev/right_hand port regardless of which EE is fitted.
         Derived from a CAD export whose rpy was in degrees (-180, 0, +-90) and whose axes are
         NOT the ROS-optical ones the 1dof values use. The rpy written here is the optical frame
         that reproduces the hand-verified MuJoCo camera orientation. Stated in the MAGNET LINK
         frame (NOT the CAD export frame): camX = +X, camY = +Z, camZ = -Y, so the view axis
         (optical +Z) is the link's -Y. Do NOT re-apply
         the 1dof conversion.
         UNVERIFIED: a review flagged that this view axis runs along the gripper body rather
         than out along the approach axis, and the magnet variant has no counterpart in the
         reference model to cross-check against. Confirm in the viewer before relying on it. -->
    <link name="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
    <joint name="${'left_hand_camera_joint' if side == 'Left' else 'right_hand_camera_joint'}" type="fixed">
      <parent link="${'l_magnet' if side == 'Left' else 'r_magnet'}"/>
      <child link="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
      <origin xyz="${side == 'Left' and '-0.00001126 0.00372014 -0.10086950' or '0.00001126 -0.00372014 -0.10086950'}" rpy="${side == 'Left' and '1.570796327 0 0' or '1.570796327 0 -3.141592653'}"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="igris_1dof_gripper_end_effector" params="side">
    <link name="${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}">
      <inertial>
        <xacro:if value="${side == 'Left'}">
          <mass value="0.271"/>
          <origin xyz="0.00396 0.00377 -0.05310"/>
          <inertia ixx="0.00033" ixy="-0.00001" ixz="-0.00003" iyy="0.00040" iyz="-0.00004" izz="0.00021"/>
        </xacro:if>
        <xacro:unless value="${side == 'Left'}">
          <mass value="0.271"/>
          <origin xyz="0.00396 -0.00377 -0.05310"/>
          <inertia ixx="0.00033" ixy="0.00001" ixz="-0.00003" iyy="0.00040" iyz="0.00004" izz="0.00021"/>
        </xacro:unless>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/1_dof_gripper/${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/1_dof_gripper/${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <link name="${'l_1_dof_gripper_moving' if side == 'Left' else 'r_1_dof_gripper_moving'}">
      <inertial>
        <xacro:if value="${side == 'Left'}">
          <mass value="0.093"/>
          <origin xyz="-0.00028 -0.00857 -0.04908"/>
          <inertia ixx="0.00007" ixy="0.00000" ixz="0.00000" iyy="0.00009" iyz="-0.00001" izz="0.00004"/>
        </xacro:if>
        <xacro:unless value="${side == 'Left'}">
          <mass value="0.093"/>
          <origin xyz="-0.00028 0.00857 -0.04908"/>
          <inertia ixx="0.00007" ixy="0.00000" ixz="0.00000" iyy="0.00009" iyz="0.00001" izz="0.00004"/>
        </xacro:unless>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/1_dof_gripper/${'l_1_dof_gripper_moving' if side == 'Left' else 'r_1_dof_gripper_moving'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/1_dof_gripper/${'l_1_dof_gripper_moving' if side == 'Left' else 'r_1_dof_gripper_moving'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}" type="fixed">
      <parent link="${'l_wrist_mount' if side == 'Left' else 'r_wrist_mount'}"/>
      <child link="${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}"/>
      <origin xyz="0 0 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" rpy="0 0 0"/>
    </joint>
    <joint name="${'l_1_dof_gripper_moving' if side == 'Left' else 'r_1_dof_gripper_moving'}" type="revolute">
      <parent link="${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}"/>
      <child link="${'l_1_dof_gripper_moving' if side == 'Left' else 'r_1_dof_gripper_moving'}"/>
      <xacro:if value="${side == 'Left'}">
        <!-- rest (q=0) = open: body pre-rolled by +travel and axis flipped so q increases toward closed -->
        <origin xyz="0 0.02625 -0.04225" rpy="1.74533 0 0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="0" upper="1.74533" effort="1000" velocity="100.0"/>
      </xacro:if>
      <xacro:unless value="${side == 'Left'}">
        <!-- rest (q=0) = open: body pre-rolled by -travel and axis flipped so q increases toward closed -->
        <origin xyz="0 -0.02625 -0.04225" rpy="-1.74533 0 0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-1.74533" upper="0" effort="1000" velocity="100.0"/>
      </xacro:unless>
    </joint>
    <!-- Camera link: ROS OPTICAL frame (+Z forward, +X right, +Y down), the convention ROS
         publishes camera data in. The MuJoCo <camera> of the same name sits inside the matching
         <frame> and carries quat="0 1 0 0" (180 deg about X); that roll is the ONLY difference
         between the two conventions, since MuJoCo looks along -Z with +Y up.
         The hand, magnet and 1dof blocks all declare this name: end_effector selects exactly
         one, so one link of it exists per expansion. It is the frame of the single
         sensor/left_hand | sensor/right_hand stream, which igris_c_camera publishes from the
         /dev/left_hand | /dev/right_hand port regardless of which EE is fitted.
         Parented to the fixed jaw, so the wrist_version z offset above does not reach it.
         The CAD export gave both sides in degrees: left (roll -158.075975, pitch -24.987626,
         yaw 90.813002), right (158.075975, -24.987626, -90.813002). Those two are a mirror in
         the roll/yaw-negated sense, which is the rule for a MOUNT frame; applied to optical
         frames it leaves the pair 180 deg apart about the view axis, i.e. one image inverted.
         A viewer check identified the LEFT as the inverted one, so the left value here is the
         optical mirror of the CAD right value rather than the CAD left value. The right side is
         the CAD value unchanged. This now matches the eyes_stereo, palm and magnet pairs, which
         all satisfy the optical-mirror rule. The view direction is untouched by the fix: only
         the roll about the view axis changed. -->
    <link name="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
    <joint name="${'left_hand_camera_joint' if side == 'Left' else 'right_hand_camera_joint'}" type="fixed">
      <parent link="${'l_1_dof_gripper_fixed' if side == 'Left' else 'r_1_dof_gripper_fixed'}"/>
      <child link="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
      <origin xyz="${side == 'Left' and '0.050416 0.020241 -0.052538' or '0.050416 -0.020241 -0.052538'}" rpy="${side == 'Left' and '2.758946232 0.436116346 -1.556606765' or '2.758946232 -0.436116346 -1.584985889'}"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="igris_hand_end_effector" params="side">
    <link name="${'l_palm' if side == 'Left' else 'r_palm'}">
      <inertial>
        <xacro:if value="${side == 'Left'}">
          <mass value="0.200"/>
          <origin xyz="0.0091 -0.00371 -0.07839"/>
          <inertia ixx="0.00081" ixy="4e-05" ixz="-0.00012" iyy="0.00117" iyz="5e-05" izz="0.00042"/>
        </xacro:if>
        <xacro:unless value="${side == 'Left'}">
          <mass value="0.200"/>
          <origin xyz="0.0091 0.00371 -0.07839"/>
          <inertia ixx="0.00081" ixy="-4e-05" ixz="-0.00012" iyy="0.00117" iyz="-5e-05" izz="0.00042"/>
        </xacro:unless>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${'l_palm' if side == 'Left' else 'r_palm'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="${random_rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${'l_palm' if side == 'Left' else 'r_palm'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="${'l_hand' if side == 'Left' else 'r_hand'}" type="fixed">
      <parent link="${'l_wrist_mount' if side == 'Left' else 'r_wrist_mount'}"/>
      <child link="${'l_palm' if side == 'Left' else 'r_palm'}"/>
      <xacro:if value="${side == 'Left'}">
        <origin xyz="0 0.0109 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" rpy="0 0 0"/>
      </xacro:if>
      <xacro:unless value="${side == 'Left'}">
        <origin xyz="0 -0.0109 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" rpy="0 0 0"/>
      </xacro:unless>
    </joint>
    <!-- Camera link: ROS OPTICAL frame (+Z forward, +X right, +Y down), the convention ROS
         publishes camera data in. The MuJoCo <camera> of the same name sits inside the matching
         <frame> and carries quat="0 1 0 0" (180 deg about X); that roll is the ONLY difference
         between the two conventions, since MuJoCo looks along -Z with +Y up.
         The hand, magnet and 1dof blocks all declare this name: end_effector selects exactly
         one, so one link of it exists per expansion. It is the frame of the single
         sensor/left_hand | sensor/right_hand stream, which igris_c_camera publishes from the
         /dev/left_hand | /dev/right_hand port regardless of which EE is fitted.
         The palm camera is mounted INVERTED (the reference model carried that roll in its USD
         sensor prim, not in the link); verified in the viewer. The L/R pair sits 0.183 deg off a
         perfect mirror; that is inherited verbatim from the reference CAD (the two palm meshes
         differ in triangle count as well) and is NOT introduced here. Massless and fixed, so it adds
         no DoF and no q-index shift to the RBDL model. -->
    <link name="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
    <joint name="${'left_hand_camera_joint' if side == 'Left' else 'right_hand_camera_joint'}" type="fixed">
      <parent link="${'l_palm' if side == 'Left' else 'r_palm'}"/>
      <child link="${'left_hand_camera_link' if side == 'Left' else 'right_hand_camera_link'}"/>
      <origin xyz="${side == 'Left' and '-0.024420 -0.010317 -0.034793' or '-0.024420 0.010317 -0.034793'}" rpy="${side == 'Left' and '2.180914100 -0.298625411 0.410346954' or '2.177863132 0.297341539 2.730347616'}"/>
    </joint>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_palm' if side == 'Left' else 'r_palm'}" part="thumb_proximal" child="thumb_middle" joint_name="0_joint_thumb_proximal" xyz="${side == 'Left' and '0.026 -0.0132 -0.0299' or '0.026 0.0132 -0.0299'}" rpy="${side == 'Left' and '3.054326988 0 0' or '-3.054326988 0 0'}" axis="0 0 1" lower="${side == 'Left' and '0' or '-1.727875959'}" upper="${side == 'Left' and '1.727875959' or '0'}" mass="0.01" inertia="1e-5" mesh="${side == 'Left' and 'l_thumb_proximal' or 'r_thumb_proximal'}"/>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_thumb_proximal' if side == 'Left' else 'r_thumb_proximal'}" part="thumb_middle" child="thumb_distal" joint_name="1_joint_thumb_middle" xyz="${side == 'Left' and '0.0230 0.0036 0.015' or '0.0230 -0.0036 0.015'}" rpy="-1.221731311 0 -1.570796752" axis="1 0 0" lower="0" upper="1.221730476" mass="0.008" inertia="8e-6" mesh="${side == 'Left' and 'l_thumb_middle' or 'r_thumb_middle'}"/>
    <xacro:igris_hand_finger_leaf side="${side}" parent="${'l_thumb_middle' if side == 'Left' else 'r_thumb_middle'}" part="thumb_distal" joint_name="2_joint_thumb_distal" xyz="0 -0.001 0.04" rpy="0 0 0" axis="1 0 0" lower="0" upper="1.570796327" mass="0.006" inertia="6e-6" mesh="${side == 'Left' and 'l_thumb_distal' or 'r_thumb_distal'}"/>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_palm' if side == 'Left' else 'r_palm'}" part="index_middle" child="index_distal" joint_name="3_joint_index_middle" xyz="${side == 'Left' and '0.0305 0.002 -0.101' or '0.0305 -0.002 -0.101'}" rpy="${side == 'Left' and '-3.141592654 0 3.141592653' or '3.141592654 0 0'}" axis="1 0 0" lower="0" upper="1.570796327" mass="0.008" inertia="8e-6" mesh="finger_middle"/>
    <xacro:igris_hand_finger_leaf side="${side}" parent="${'l_index_middle' if side == 'Left' else 'r_index_middle'}" part="index_distal" joint_name="4_joint_index_distal" xyz="0 -0.001 0.04" rpy="0 0 0" axis="1 0 0" lower="0" upper="1.570796327" mass="0.006" inertia="6e-6" mesh="finger_distal"/>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_palm' if side == 'Left' else 'r_palm'}" part="middle_middle" child="middle_distal" joint_name="5_joint_middle_middle" xyz="${side == 'Left' and '0.0085 0.002 -0.101' or '0.0085 -0.002 -0.101'}" rpy="${side == 'Left' and '-3.141592654 0 3.141592653' or '3.141592654 0 0'}" axis="1 0 0" lower="0" upper="1.570796327" mass="0.008" inertia="8e-6" mesh="finger_middle"/>
    <xacro:igris_hand_finger_leaf side="${side}" parent="${'l_middle_middle' if side == 'Left' else 'r_middle_middle'}" part="middle_distal" joint_name="6_joint_middle_distal" xyz="0 -0.001 0.04" rpy="0 0 0" axis="1 0 0" lower="0" upper="1.570796327" mass="0.006" inertia="6e-6" mesh="finger_distal"/>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_palm' if side == 'Left' else 'r_palm'}" part="ring_middle" child="ring_distal" joint_name="7_joint_ring_middle" xyz="${side == 'Left' and '-0.0139 0.001 -0.099' or '-0.0139 -0.001 -0.099'}" rpy="${side == 'Left' and '3.14037309 -0.0348858149 -3.10666428' or '3.14037309 0.0348858149 -0.0349283776'}" axis="1 0 0" lower="0" upper="1.570796327" mass="0.008" inertia="8e-6" mesh="finger_middle"/>
    <xacro:igris_hand_finger_leaf side="${side}" parent="${'l_ring_middle' if side == 'Left' else 'r_ring_middle'}" part="ring_distal" joint_name="8_joint_ring_distal" xyz="0 -0.001 0.04" rpy="0 0 0" axis="1 0 0" lower="0" upper="1.570796327" mass="0.006" inertia="6e-6" mesh="finger_distal"/>
    <xacro:igris_hand_finger_chain side="${side}" parent="${'l_palm' if side == 'Left' else 'r_palm'}" part="little_middle" child="little_distal" joint_name="9_joint_little_middle" xyz="${side == 'Left' and '-0.0362 -0.0012 -0.0942' or '-0.0362 0.0012 -0.0942'}" rpy="${side == 'Left' and '3.13884432 -0.0872096601 -3.08908091' or '3.13884432 0.0872096601 -0.0525117398'}" axis="1 0 0" lower="0" upper="1.570796327" mass="0.008" inertia="8e-6" mesh="finger_middle"/>
    <xacro:igris_hand_finger_leaf side="${side}" parent="${'l_little_middle' if side == 'Left' else 'r_little_middle'}" part="little_distal" joint_name="10_joint_little_distal" xyz="0 -0.001 0.04" rpy="0 0 0" axis="1 0 0" lower="0" upper="1.570796327" mass="0.006" inertia="6e-6" mesh="finger_distal"/>
  </xacro:macro>
  <xacro:macro name="igris_hand_finger_chain" params="side parent part child joint_name xyz rpy axis lower upper mass inertia mesh">
    <link name="${('l_' if side == 'Left' else 'r_') + part}">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="${inertia}" ixy="0" ixz="0" iyy="${inertia}" iyz="0" izz="${inertia}"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${mesh}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="${random_rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${mesh}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="${('l_' if side == 'Left' else 'r_') + joint_name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${('l_' if side == 'Left' else 'r_') + part}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="1000" velocity="100.0"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="igris_hand_finger_leaf" params="side parent part joint_name xyz rpy axis lower upper mass inertia mesh">
    <link name="${('l_' if side == 'Left' else 'r_') + part}">
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="${inertia}" ixy="0" ixz="0" iyy="${inertia}" iyz="0" izz="${inertia}"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${mesh}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="${random_rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_prefix}/hand/${mesh}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="${('l_' if side == 'Left' else 'r_') + joint_name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${('l_' if side == 'Left' else 'r_') + part}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="1000" velocity="100.0"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="igris_lowerarm_module" params="side parallel">
    <link name="${side == 'Left' and 'l_forearm' or 'r_forearm'}">
      <inertial>
        <mass value="2.428"/>
        <origin xyz="${side == 'Left' and '0.01024 -0.00369 -0.11953' or '0.01024 0.00369 -0.11953'}"/>
        <inertia ixx="0.00919" ixy="${side == 'Left' and '0.00002' or '-0.00002'}" ixz="-0.00063" iyy="0.00944" iyz="${side == 'Left' and '-0.00017' or '0.00017'}" izz="0.00179"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_forearm' or 'r_forearm'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_forearm' or 'r_forearm'}.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <!-- v2 offsets the pitch axis below the roll axis; limits, inertials and meshes move with it. -->
    <xacro:if value="${wrist_version_value == 'v2'}">
      <joint name="${side == 'Left' and 'l_wrist_roll' or 'r_wrist_roll'}" type="revolute">
        <parent link="${side == 'Left' and 'l_forearm' or 'r_forearm'}"/>
        <child link="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}"/>
        <origin xyz="${side == 'Left' and '0 -0.005 -0.2395' or '0 0.005 -0.2395'}" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${side == 'Left' and '-1.483529864' or '-0.837758041'}" upper="${side == 'Left' and '0.837758041' or '1.483529864'}" effort="1000" velocity="100.0"/>
      </joint>
      <link name="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}">
        <inertial>
          <mass value="0.032863"/>
          <origin xyz="${side == 'Left' and '-1.709e-08 0.009783 -0.006545' or '-1.709e-08 -0.009783 -0.006545'}"/>
          <inertia ixx="4.514218e-06" ixy="${side == 'Left' and '1.3e-11' or '-1.3e-11'}" ixz="-1.3e-11" iyy="8.32556e-06" iyz="${side == 'Left' and '9.42445e-07' or '-9.42445e-07'}" izz="9.474258e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <joint name="${side == 'Left' and 'l_wrist_pitch' or 'r_wrist_pitch'}" type="revolute">
        <parent link="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}"/>
        <child link="${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}"/>
        <origin xyz="0 0 -0.0105" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5759586532" upper="0.5759586532" effort="1000" velocity="100.0"/>
      </joint>
      <link name="${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}">
        <inertial>
          <mass value="0.058869"/>
          <origin xyz="${side == 'Left' and '7.648e-09 0.015805 -0.02495' or '7.648e-09 -0.015805 -0.02495'}"/>
          <inertia ixx="1.4915696e-05" ixy="${side == 'Left' and '-4e-12' or '4e-12'}" ixz="-4e-12" iyy="1.5860639e-05" iyz="${side == 'Left' and '-1.893388e-06' or '1.893388e-06'}" izz="6.306108e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
    </xacro:if>
    <xacro:unless value="${wrist_version_value == 'v2'}">
      <joint name="${side == 'Left' and 'l_wrist_roll' or 'r_wrist_roll'}" type="revolute">
        <parent link="${side == 'Left' and 'l_forearm' or 'r_forearm'}"/>
        <child link="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}"/>
        <origin xyz="${side == 'Left' and '0 -0.005 -0.2395' or '0 0.005 -0.2395'}" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${side == 'Left' and '-1.483529864' or '-0.959931089'}" upper="${side == 'Left' and '0.959931089' or '1.483529864'}" effort="1000" velocity="100.0"/>
      </joint>
      <link name="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}">
        <inertial>
          <mass value="0.012"/>
          <origin xyz="${side == 'Left' and '0.00000 0.00604 0.00031' or '0.00000 -0.00604 0.00031'}"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <joint name="${side == 'Left' and 'l_wrist_pitch' or 'r_wrist_pitch'}" type="revolute">
        <parent link="${side == 'Left' and 'l_wrist_coupler' or 'r_wrist_coupler'}"/>
        <child link="${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.698131701" upper="0.698131701" effort="1000" velocity="100.0"/>
      </joint>
      <link name="${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}">
        <inertial>
          <mass value="0.032"/>
          <origin xyz="${side == 'Left' and '0 0.01203 -0.02699' or '0 -0.01203 -0.02699'}"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/${side == 'Left' and 'l_wrist_mount' or 'r_wrist_mount'}_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
    </xacro:unless>
    <xacro:if value="${parallel and side == 'Left'}">
      <xacro:igris_parallel_left_wrist/>
    </xacro:if>
    <xacro:if value="${parallel and side == 'Right'}">
      <xacro:igris_parallel_right_wrist/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'dummy'}">
      <xacro:igris_dummy_end_effector side="${side}"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'none'}">
      <xacro:igris_no_end_effector side="${side}"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'hand'}">
      <xacro:igris_hand_end_effector side="${side}"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == '1dof'}">
      <xacro:igris_1dof_gripper_end_effector side="${side}"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'magnet'}">
      <xacro:igris_magnet_end_effector side="${side}"/>
    </xacro:if>
  </xacro:macro>
</robot>
