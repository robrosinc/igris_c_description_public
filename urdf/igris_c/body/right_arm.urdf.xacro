  <!-- ===================== End-effector dispatch ===================== -->
  <!-- end_effector:=none adds nothing; hand, magnet and 1dof live in body/right_end_effector. -->
  <!-- Dummy end effector (end_effector:=dummy): sphere mass on the forearm. -->
  <xacro:if value="${end_effector_value == 'dummy'}">
    <link name="r_hand_dummy">
      <inertial>
        <mass value="0.150"/>
        <origin xyz="0.00910 -0.00371 0.07839"/>
        <inertia ixx="0.00081" ixy="0.00004" ixz="0.00012" iyy="0.00117" iyz="-0.00005" izz="0.00042"/>
      </inertial>
      <visual>
        <origin xyz="0 -0.005 0.0365" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 -0.005 0.0365" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="r_hand" type="fixed">
      <parent link="r_forearm"/>
      <child link="r_hand_dummy"/>
      <origin xyz="0 -0.0059 -0.2635" rpy="3.14 0 0"/>
    </joint>
  </xacro:if>
  <xacro:include filename="right_end_effector.urdf.xacro"/>
</robot>
