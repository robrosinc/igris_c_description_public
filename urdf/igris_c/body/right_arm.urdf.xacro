<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Right arm: shoulder -> elbow -> forearm -> wrist (v1/v2), parallel wrist linkage, end-effector dispatch.
       Included by body/{torso,pelvis}_base. -->
  <!-- ===================== Shoulder and elbow ===================== -->
  <joint name="r_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="r_shoulder_frame"/>
    <origin xyz="0 -0.171 0.266" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141592654" upper="1.047197551" effort="1000" velocity="100.0"/>
  </joint>
  <link name="r_shoulder_frame">
    <inertial>
      <mass value="1.105"/>
      <origin xyz="-0.00458 -0.00011 0.04499"/>
      <inertia ixx="0.00181" ixy="0.00000" ixz="-0.00008" iyy="0.00180" iyz="0.00000" izz="0.00101"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_shoulder_frame.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="random">
        <color rgba="0.0706 0.0706 0.0706 0.7"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_shoulder_frame.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="r_shoulder_roll" type="revolute">
    <parent link="r_shoulder_frame"/>
    <child link="r_shoulder_bracket"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141592654" upper="0.174532925" effort="1000" velocity="100.0"/>
  </joint>
  <link name="r_shoulder_bracket">
    <inertial>
      <mass value="0.253"/>
      <origin xyz="0.01754 -0.02514 0.00000"/>
      <inertia ixx="0.00006" ixy="-0.00003" ixz="0.00000" iyy="0.00034" iyz="-0.00000" izz="0.00035"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_shoulder_bracket.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="random">
        <color rgba="0.0706 0.0706 0.0706 0.7"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_shoulder_bracket.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="r_shoulder_yaw" type="revolute">
    <parent link="r_shoulder_bracket"/>
    <child link="r_upper_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
  </joint>
  <link name="r_upper_arm">
    <inertial>
      <mass value="2.144"/>
      <origin xyz="-0.00169 0.00639 -0.10638"/>
      <inertia ixx="0.00966" ixy="0.00001" ixz="-0.00010" iyy="0.00981" iyz="0.00034" izz="0.00217"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_upper_arm.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="random">
        <color rgba="0.0706 0.0706 0.0706 0.7"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_upper_arm.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="r_elbow_pitch" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_elbow_bracket"/>
    <origin xyz="0.01 0 -0.197" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395102" upper="0" effort="1000" velocity="100.0"/>
  </joint>
  <link name="r_elbow_bracket">
    <inertial>
      <mass value="0.137"/>
      <origin xyz="0.00544 -0.00380 -0.03838"/>
      <inertia ixx="0.00008" ixy="0.00000" ixz="-0.00001" iyy="0.00010" iyz="0.00001" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_elbow_bracket.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="random">
        <color rgba="0.0706 0.0706 0.0706 0.7"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_elbow_bracket.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <!-- ===================== Forearm and wrist ===================== -->
  <joint name="r_wrist_yaw" type="revolute">
    <parent link="r_elbow_bracket"/>
    <child link="r_forearm"/>
    <origin xyz="-0.01 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
  </joint>
  <link name="r_forearm">
    <!-- The hand variant mounts a different forearm assembly, so its inertial differs;
         every other end_effector keeps the base one. -->
    <xacro:if value="${end_effector_value == 'hand'}">
      <inertial>
        <mass value="2.395"/>
        <origin xyz="0.00007 -0.00046 -0.08808"/>
        <inertia ixx="0.009823" ixy="-0.000001" ixz="0.000021" iyy="0.010713" iyz="-0.000109" izz="0.003128"/>
      </inertial>
    </xacro:if>
    <xacro:unless value="${end_effector_value == 'hand'}">
      <inertial>
        <mass value="2.212"/>
        <origin xyz="0.00000 -0.00096 -0.08279"/>
        <inertia ixx="0.008905" ixy="0.000000" ixz="0.000007" iyy="0.009782" iyz="-0.000199" izz="0.003011"/>
      </inertial>
    </xacro:unless>
    <visual>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_forearm.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="random">
        <color rgba="0.0706 0.0706 0.0706 0.7"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://igris_c_description/meshes/igris_c/r_forearm.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <!-- Wrist v2: pitch axis offset below the roll axis; limits, inertials and meshes differ from v1. -->
  <xacro:if value="${wrist_version_value == 'v2'}">
    <joint name="r_wrist_roll" type="revolute">
      <parent link="r_forearm"/>
      <child link="r_wrist_coupler"/>
      <origin xyz="0 0.005 -0.2395" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.837758041" upper="1.483529864" effort="1000" velocity="100.0"/>
    </joint>
    <link name="r_wrist_coupler">
      <inertial>
        <mass value="0.032863"/>
        <origin xyz="-1.709e-08 -0.009783 -0.006545"/>
        <inertia ixx="4.514218e-06" ixy="-1.3e-11" ixz="-1.3e-11" iyy="8.32556e-06" iyz="-9.42445e-07" izz="9.474258e-06"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="${random_rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="r_wrist_pitch" type="revolute">
      <parent link="r_wrist_coupler"/>
      <child link="r_wrist_mount"/>
      <origin xyz="0 0 -0.0105" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.5759586532" upper="0.5759586532" effort="1000" velocity="100.0"/>
    </joint>
    <link name="r_wrist_mount">
      <inertial>
        <mass value="0.058869"/>
        <origin xyz="7.648e-09 -0.015805 -0.02495"/>
        <inertia ixx="1.4915696e-05" ixy="4e-12" ixz="-4e-12" iyy="1.5860639e-05" iyz="1.893388e-06" izz="6.306108e-06"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="${random_rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
  </xacro:if>
  <!-- Wrist v1 -->
  <xacro:unless value="${wrist_version_value == 'v2'}">
    <joint name="r_wrist_roll" type="revolute">
      <parent link="r_forearm"/>
      <child link="r_wrist_coupler"/>
      <origin xyz="0 0.005 -0.2395" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.959931089" upper="1.483529864" effort="1000" velocity="100.0"/>
    </joint>
    <link name="r_wrist_coupler">
      <inertial>
        <mass value="0.012"/>
        <origin xyz="0.00000 -0.00604 0.00031"/>
        <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_coupler_v1.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_coupler_v1.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="r_wrist_pitch" type="revolute">
      <parent link="r_wrist_coupler"/>
      <child link="r_wrist_mount"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.698131701" upper="0.698131701" effort="1000" velocity="100.0"/>
    </joint>
    <link name="r_wrist_mount">
      <inertial>
        <mass value="0.032"/>
        <origin xyz="0 -0.01203 -0.02699"/>
        <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_mount_v1.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/common/r_wrist_mount_v1.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
  </xacro:unless>
  <!-- ===================== Parallel wrist linkage (parallel:=true) ===================== -->
  <xacro:if value="${parallel_value}">
    <!-- v2: ball joints decomposed into gimbal revolutes -->
    <xacro:if value="${wrist_version_value == 'v2'}">
      <link name="r_wrist_connector_front">
        <inertial>
          <mass value="0.01031"/>
          <origin xyz="-0.012246 -0.013095 -0.002074"/>
          <inertia ixx="1.546284e-06" ixy="-6.21838e-07" ixz="-9.8489e-08" iyy="5.42679e-07" iyz="-1.98741e-07" izz="1.766002e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_connector_back">
        <inertial>
          <mass value="0.01031"/>
          <origin xyz="0.012246 -0.013095 -0.002074"/>
          <inertia ixx="1.546284e-06" ixy="6.21838e-07" ixz="9.8489e-08" iyy="5.42679e-07" iyz="-1.98741e-07" izz="1.766002e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_parallel_front_ry">
        <inertial>
          <mass value="0"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
      </link>
      <link name="r_wrist_parallel_front_rx">
        <inertial>
          <mass value="0"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
      </link>
      <link name="r_wrist_parallel_front">
        <inertial>
          <mass value="0.013631"/>
          <origin xyz="0.00135 -0.010135 0.022592"/>
          <inertia ixx="4.968614e-06" ixy="6.6531e-08" ixz="3.36696e-07" iyy="4.480709e-06" iyz="6.1995e-07" izz="7.91828e-07"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_parallel_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_parallel_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_parallel_back_ry">
        <inertial>
          <mass value="0"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
      </link>
      <link name="r_wrist_parallel_back_rx">
        <inertial>
          <mass value="0"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
      </link>
      <link name="r_wrist_parallel_back">
        <inertial>
          <mass value="0.013631"/>
          <origin xyz="-0.00135 -0.010135 0.022592"/>
          <inertia ixx="4.968614e-06" ixy="-6.6531e-08" ixz="-3.36696e-07" iyy="4.480709e-06" iyz="6.1995e-07" izz="7.91828e-07"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_parallel_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_parallel_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <joint name="r_wrist_connector_front" type="revolute">
        <parent link="r_forearm"/>
        <child link="r_wrist_connector_front"/>
        <origin xyz="0.029 0.009341 -0.21488" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_connector_back" type="revolute">
        <parent link="r_forearm"/>
        <child link="r_wrist_connector_back"/>
        <origin xyz="-0.029 0.009341 -0.21488" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <!-- MJCF closes each rod with one ball joint; URDF has no ball type, so each is
           decomposed into three revolutes (ry, rx, z) through two zero-mass gimbal links. -->
      <joint name="r_wrist_parallel_front_ry" type="revolute">
        <parent link="r_wrist_mount"/>
        <child link="r_wrist_parallel_front_ry"/>
        <origin xyz="0.021 -0.02025 -0.01675" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_parallel_front_rx" type="revolute">
        <parent link="r_wrist_parallel_front_ry"/>
        <child link="r_wrist_parallel_front_rx"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_parallel_front" type="revolute">
        <parent link="r_wrist_parallel_front_rx"/>
        <child link="r_wrist_parallel_front"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_parallel_back_ry" type="revolute">
        <parent link="r_wrist_mount"/>
        <child link="r_wrist_parallel_back_ry"/>
        <origin xyz="-0.021 -0.02025 -0.01675" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_parallel_back_rx" type="revolute">
        <parent link="r_wrist_parallel_back_ry"/>
        <child link="r_wrist_parallel_back_rx"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="r_wrist_parallel_back" type="revolute">
        <parent link="r_wrist_parallel_back_rx"/>
        <child link="r_wrist_parallel_back"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
    </xacro:if>
    <!-- v1: universal + revolute pairs -->
    <xacro:unless value="${wrist_version_value == 'v2'}">
      <link name="r_wrist_connector_front">
        <inertial>
          <mass value="0.009"/>
          <origin xyz="-0.00357 -0.01879 0.00461"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_front_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_front_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_connector_back">
        <inertial>
          <mass value="0.009"/>
          <origin xyz="0.00357 -0.01879 0.00461"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_connector_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_universal_front">
        <inertial>
          <mass value="0.005"/>
          <origin xyz="0.00000 0.00189 -0.00004"/>
          <inertia ixx="0.000001" ixy="0.00000" ixz="0.00000" iyy="0.000001" iyz="0.00000" izz="0.000001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_universal_front_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_universal_front_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="r_wrist_parallel_front">
        <inertial>
          <mass value="0.017"/>
          <origin xyz="-0.00094 0.00038 -0.01026"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/r_wrist_parallel_front_v1.stl" scale="0.01 0.01 0.01"/>
