          </geometry>
        </collision>
      </link>
      <link name="l_wrist_universal_back">
        <inertial>
          <mass value="0.002"/>
          <origin xyz="0.00000 -0.00189 -0.00004"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/l_wrist_universal_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/l_wrist_universal_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="l_wrist_parallel_back">
        <inertial>
          <mass value="0.017"/>
          <origin xyz="0.00094 -0.00038 -0.01026"/>
          <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00001" iyz="0.00000" izz="0.00001"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/l_wrist_parallel_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="0.0706 0.0706 0.0706 0.7"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/common/l_wrist_parallel_back_v1.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <joint name="l_wrist_connector_front" type="revolute">
        <parent link="l_forearm"/>
        <child link="l_wrist_connector_front"/>
        <origin xyz="0.02000 -0.00934 -0.22388" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="l_wrist_connector_back" type="revolute">
        <parent link="l_forearm"/>
        <child link="l_wrist_connector_back"/>
        <origin xyz="-0.02000 -0.00934 -0.22388" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="l_wrist_universal_front" type="revolute">
        <parent link="l_wrist_mount"/>
        <child link="l_wrist_universal_front"/>
        <origin xyz="0.01000 0.02150 -0.01000" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="l_wrist_parallel_front" type="revolute">
        <parent link="l_wrist_universal_front"/>
        <child link="l_wrist_parallel_front"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="l_wrist_universal_back" type="revolute">
        <parent link="l_wrist_mount"/>
        <child link="l_wrist_universal_back"/>
        <origin xyz="-0.01000 0.02150 -0.01000" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
      <joint name="l_wrist_parallel_back" type="revolute">
        <parent link="l_wrist_universal_back"/>
        <child link="l_wrist_parallel_back"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
      </joint>
    </xacro:unless>
  </xacro:if>
  <!-- ===================== End-effector dispatch ===================== -->
  <!-- end_effector:=none adds nothing; hand, magnet and 1dof live in body/left_end_effector. -->
  <!-- Dummy end effector (end_effector:=dummy): sphere mass on the forearm. -->
  <xacro:if value="${end_effector_value == 'dummy'}">
    <link name="l_hand_dummy">
      <inertial>
        <mass value="0.150"/>
        <origin xyz="0.00910 0.00371 0.07839"/>
        <inertia ixx="0.00081" ixy="-0.00004" ixz="0.00012" iyy="0.00117" iyz="0.00005" izz="0.00042"/>
      </inertial>
      <visual>
        <origin xyz="0 0.005 0.0365" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
        <material name="random">
          <color rgba="0.58 0.58 0.60 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.005 0.0365" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
      </collision>
    </link>
    <joint name="l_hand" type="fixed">
      <parent link="l_forearm"/>
      <child link="l_hand_dummy"/>
      <origin xyz="0 0.0059 -0.2725" rpy="3.14 0 0"/>
    </joint>
  </xacro:if>
  <xacro:include filename="left_end_effector.urdf.xacro"/>
</robot>
