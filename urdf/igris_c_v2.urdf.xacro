  <xacro:macro name="igris_c_torso_base_block">
    <!-- base_link -> torso -> waist chain -> pelvis -->
    <link name="base_link"/>
    <joint name="base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="torso"/>
    </joint>
    <link name="torso">
