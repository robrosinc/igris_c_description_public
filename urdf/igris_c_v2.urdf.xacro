<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igris_c_v2">
  <!-- ===================== 1. Parameters (xacro args) ===================== -->
  <xacro:arg name="base_type" default="torso"/>
  <xacro:arg name="parallel" default="false"/>
  <xacro:arg name="end_effector" default="dummy"/>
  <xacro:arg name="ankle_version" default="v1"/>
  <xacro:arg name="wrist_version" default="v1"/>
  <!-- ===================== 2. Constants (xacro properties) ===================== -->
  <xacro:property name="random_rgba" value="0.0706 0.0706 0.0706 0.7"/>
  <xacro:property name="base_type_value" value="$(arg base_type)"/>
  <xacro:property name="parallel_enabled" value="${str('$(arg parallel)').lower() == 'true'}"/>
  <!-- ankle_version: v1 = original foot, v2 = reinforced foot (heavier, shifted COM, new PLA anchors). -->
  <xacro:property name="ankle_version_value" value="$(arg ankle_version)"/>
  <!-- wrist_version: v1 = intersecting roll/pitch axes with a universal+revolute rod pair.
       v2 = offset roll/pitch axes; MJCF closes the rod with a ball joint, which URDF has no type
       for, so it is decomposed into three revolutes through two zero-mass gimbal links. -->
  <xacro:property name="wrist_version_value" value="$(arg wrist_version)"/>
  <!-- ===================== 3. Reusable macro definitions ===================== -->
  <xacro:macro name="igris_parallel_waist">
    <link name="dummy_1_x"/>
    <link name="dummy_1_y"/>
    <link name="dummy_2_x"/>
    <link name="dummy_2_y"/>
    <link name="l_waist_flange">
      <inertial>
        <mass value="0.043"/>
        <origin xyz="-0.01470 -0.00883 -0.00167"/>
        <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00004" iyz="0.00000" izz="0.00003"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_waist_flange.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_waist_flange.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <link name="l_waist_parallel">
      <inertial>
        <mass value="0.030"/>
        <origin xyz="0.00083 0.00172 0.02995"/>
        <inertia ixx="0.00002" ixy="0.00000" ixz="0.00000" iyy="0.00002" iyz="0.00000" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_waist_parallel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_waist_parallel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <link name="r_waist_flange">
      <inertial>
        <mass value="0.043"/>
        <origin xyz="-0.01470 0.00883 -0.00167"/>
        <inertia ixx="0.00001" ixy="0.00000" ixz="0.00000" iyy="0.00004" iyz="0.00000" izz="0.00003"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/r_waist_flange.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/r_waist_flange.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <link name="r_waist_parallel">
      <inertial>
        <mass value="0.030"/>
        <origin xyz="0.00083 -0.00172 0.02995"/>
        <inertia ixx="0.00002" ixy="0.00000" ixz="0.00000" iyy="0.00002" iyz="0.00000" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/r_waist_parallel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="random">
          <color rgba="0.0706 0.0706 0.0706 0.7"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igris_c_description/meshes/igris_c_v2/r_waist_parallel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    <joint name="l_waist_flange" type="revolute">
      <parent link="pelvis"/>
      <child link="l_waist_flange"/>
      <origin xyz="0 0.09050 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="l_waist_parallel_x" type="revolute">
      <parent link="l_waist_flange"/>
      <child link="dummy_1_x"/>
      <origin xyz="-0.05167 0.00000 -0.00587" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="l_waist_parallel_y" type="revolute">
      <parent link="dummy_1_x"/>
      <child link="dummy_1_y"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="l_waist_parallel_z" type="revolute">
      <parent link="dummy_1_y"/>
      <child link="l_waist_parallel"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="r_waist_flange" type="revolute">
      <parent link="pelvis"/>
      <child link="r_waist_flange"/>
      <origin xyz="0 -0.09050 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="r_waist_parallel_x" type="revolute">
      <parent link="r_waist_flange"/>
      <child link="dummy_2_x"/>
      <origin xyz="-0.05167 0.00000 -0.00587" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="r_waist_parallel_y" type="revolute">
      <parent link="dummy_2_x"/>
      <child link="dummy_2_y"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
    <joint name="r_waist_parallel_z" type="revolute">
      <parent link="dummy_2_y"/>
      <child link="r_waist_parallel"/>
      <origin xyz="0 0 0 " rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.570796327" upper="1.570796327" effort="1000" velocity="100.0"/>
    </joint>
  </xacro:macro>
