  <xacro:macro name="igris_parallel_left_wrist">
    <xacro:if value="${wrist_version_value == 'v2'}">
      <link name="l_wrist_connector_front">
        <inertial>
          <mass value="0.01031"/>
          <origin xyz="-0.012246 0.013095 -0.002074"/>
          <inertia ixx="1.546284e-06" ixy="6.21838e-07" ixz="-9.8489e-08" iyy="5.42679e-07" iyz="1.98741e-07" izz="1.766002e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="l_wrist_connector_back">
        <inertial>
          <mass value="0.01031"/>
          <origin xyz="0.012246 0.013095 -0.002074"/>
          <inertia ixx="1.546284e-06" ixy="-6.21838e-07" ixz="9.8489e-08" iyy="5.42679e-07" iyz="1.98741e-07" izz="1.766002e-06"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
          <material name="random">
            <color rgba="${random_rgba}"/>
          </material>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://igris_c_description/meshes/igris_c_v2/l_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
          </geometry>
        </collision>
      </link>
      <link name="l_wrist_parallel_front_ry">
        <inertial>
          <mass value="0"/>
