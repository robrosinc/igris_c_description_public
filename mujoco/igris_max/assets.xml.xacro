    <mesh name="r_wrist_connector_back_v1" file="common/r_wrist_connector_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_front_v1" file="common/r_wrist_parallel_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_back_v1" file="common/r_wrist_parallel_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_universal_front_v1" file="common/r_wrist_universal_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_universal_back_v1" file="common/r_wrist_universal_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_front_v1" file="common/l_wrist_flange_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_front_v1" file="common/l_wrist_rod_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_back_v1" file="common/l_wrist_flange_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_back_v1" file="common/l_wrist_rod_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_front_v1" file="common/r_wrist_flange_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_front_v1" file="common/r_wrist_rod_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_back_v1" file="common/r_wrist_flange_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_back_v1" file="common/r_wrist_rod_back_v1.stl" scale="0.01 0.01 0.01"/>
    <!-- v2 wrist meshes. Declared unconditionally, matching the foot_v1/foot_v2 pair. -->
    <mesh name="l_wrist_coupler_v2" file="common/l_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_mount_v2" file="common/l_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_front_v2" file="common/l_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_back_v2" file="common/l_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_front_v2" file="common/l_wrist_flange_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_back_v2" file="common/l_wrist_flange_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_front_v2" file="common/l_wrist_rod_front_v2.stl" scale="0.01 0.01 0.01"/>
