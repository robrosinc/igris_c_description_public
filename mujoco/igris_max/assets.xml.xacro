    <mesh name="r_wrist_coupler_v2" file="common/r_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_mount_v2" file="common/r_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_front_v2" file="common/r_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_back_v2" file="common/r_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_front_v2" file="common/r_wrist_flange_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_back_v2" file="common/r_wrist_flange_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_front_v2" file="common/r_wrist_rod_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_back_v2" file="common/r_wrist_rod_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_front_v2" file="common/r_wrist_parallel_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_back_v2" file="common/r_wrist_parallel_back_v2.stl" scale="0.01 0.01 0.01"/>
    <texture type="skybox" builtin="gradient" width="128" height="128" rgb1="1.0 1.0 1.0" rgb2="0.4 0.4 0.4"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.9 0.9 0.9" rgb2=".85 .85 .85"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <!-- end_effector meshes: declared only for the selected end_effector. -->
    <xacro:if value="${end_effector_value == 'hand'}">
      <mesh name="l_palm" file="common/end_effector/hand/l_palm.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_palm" file="common/end_effector/hand/r_palm.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_proximal" file="common/end_effector/hand/l_thumb_proximal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_middle" file="common/end_effector/hand/l_thumb_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_distal" file="common/end_effector/hand/l_thumb_distal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_proximal" file="common/end_effector/hand/r_thumb_proximal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_middle" file="common/end_effector/hand/r_thumb_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_distal" file="common/end_effector/hand/r_thumb_distal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="finger_middle" file="common/end_effector/hand/finger_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="finger_distal" file="common/end_effector/hand/finger_distal.stl" scale="0.01 0.01 0.01"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'magnet'}">
      <!-- Metric CAD export, like the igris_max-specific meshes above and unlike the
           cm-scaled common/ ones. -->
      <mesh name="l_magnet" file="common/end_effector/magnet/l_magnet_gripper.stl" scale="1 1 1"/>
      <mesh name="r_magnet" file="common/end_effector/magnet/r_magnet_gripper.stl" scale="1 1 1"/>
      <mesh name="l_magnet_head" file="common/end_effector/magnet/l_magnet.stl" scale="1 1 1"/>
      <mesh name="r_magnet_head" file="common/end_effector/magnet/r_magnet.stl" scale="1 1 1"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == '1dof'}">
      <mesh name="l_1_dof_gripper_fixed" file="common/end_effector/1_dof_gripper/l_1_dof_gripper_fixed.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_1_dof_gripper_moving" file="common/end_effector/1_dof_gripper/l_1_dof_gripper_moving.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_1_dof_gripper_fixed" file="common/end_effector/1_dof_gripper/r_1_dof_gripper_fixed.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_1_dof_gripper_moving" file="common/end_effector/1_dof_gripper/r_1_dof_gripper_moving.stl" scale="0.01 0.01 0.01"/>
    </xacro:if>
  </asset>
</mujoco>
