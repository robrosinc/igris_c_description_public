    <mesh name="r_shoulder_frame" file="igris_max/r_shoulder_frame.stl" scale="1 1 1"/>
    <mesh name="r_shoulder_bracket" file="igris_max/r_shoulder_bracket.stl" scale="1 1 1"/>
    <mesh name="r_upper_arm" file="igris_max/r_upper_arm.stl" scale="1 1 1"/>
    <mesh name="r_elbow_bracket" file="igris_max/r_elbow_bracket.stl" scale="1 1 1"/>
