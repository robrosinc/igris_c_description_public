    <mesh name="l_ankle_flange_in" file="common/l_ankle_flange_in.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_parallel_out" file="common/l_ankle_parallel_out.stl" scale="0.01 0.01 0.01"/>
