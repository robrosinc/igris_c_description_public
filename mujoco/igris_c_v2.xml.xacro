    <motor name="l_shoulder_yaw" joint="l_shoulder_yaw" class="actuator_60"/>
    <motor name="l_elbow_pitch" joint="l_elbow_pitch" class="actuator_60"/>
    <xacro:if value="${parallel_value}">
      <motor name="l_wrist_yaw" joint="l_wrist_yaw" class="actuator_8"/>
      <motor name="l_wrist_flange_front" joint="l_wrist_flange_front" class="actuator_8"/>
      <motor name="l_wrist_flange_back" joint="l_wrist_flange_back" class="actuator_8"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <motor name="l_wrist_yaw" joint="l_wrist_yaw" class="actuator_8"/>
      <motor name="l_wrist_roll" joint="l_wrist_roll" class="actuator_8"/>
      <motor name="l_wrist_pitch" joint="l_wrist_pitch" class="actuator_8"/>
    </xacro:unless>
    <motor name="r_shoulder_pitch" joint="r_shoulder_pitch" class="actuator_60"/>
    <motor name="r_shoulder_roll" joint="r_shoulder_roll" class="actuator_60"/>
    <motor name="r_shoulder_yaw" joint="r_shoulder_yaw" class="actuator_60"/>
    <motor name="r_elbow_pitch" joint="r_elbow_pitch" class="actuator_60"/>
    <xacro:if value="${parallel_value}">
      <motor name="r_wrist_yaw" joint="r_wrist_yaw" class="actuator_8"/>
      <motor name="r_wrist_flange_front" joint="r_wrist_flange_front" class="actuator_8"/>
      <motor name="r_wrist_flange_back" joint="r_wrist_flange_back" class="actuator_8"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <motor name="r_wrist_yaw" joint="r_wrist_yaw" class="actuator_8"/>
      <motor name="r_wrist_roll" joint="r_wrist_roll" class="actuator_8"/>
      <motor name="r_wrist_pitch" joint="r_wrist_pitch" class="actuator_8"/>
    </xacro:unless>
    <motor name="neck_yaw" joint="neck_yaw" class="actuator_7"/>
    <motor name="neck_pitch" joint="neck_pitch" class="actuator_7"/>
    <xacro:if value="${parallel_value}">
      <position name="waist_yaw_Pos" joint="waist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_waist_flange_Pos" joint="l_waist_flange" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_waist_flange_Pos" joint="r_waist_flange" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <position name="waist_yaw_Pos" joint="waist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="waist_roll_Pos" joint="waist_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="waist_pitch_Pos" joint="waist_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:unless>
    <position name="l_hip_pitch_Pos" joint="l_hip_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_hip_roll_Pos" joint="l_hip_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_hip_yaw_Pos" joint="l_hip_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_knee_pitch_Pos" joint="l_knee_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <xacro:if value="${parallel_value}">
      <position name="l_ankle_flange_out_Pos" joint="l_ankle_flange_out" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_ankle_flange_in_Pos" joint="l_ankle_flange_in" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <position name="l_ankle_pitch_Pos" joint="l_ankle_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_ankle_roll_Pos" joint="l_ankle_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:unless>
    <position name="r_hip_pitch_Pos" joint="r_hip_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_hip_roll_Pos" joint="r_hip_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_hip_yaw_Pos" joint="r_hip_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_knee_pitch_Pos" joint="r_knee_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <xacro:if value="${parallel_value}">
      <position name="r_ankle_flange_out_Pos" joint="r_ankle_flange_out" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_ankle_flange_in_Pos" joint="r_ankle_flange_in" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <position name="r_ankle_pitch_Pos" joint="r_ankle_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_ankle_roll_Pos" joint="r_ankle_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:unless>
    <position name="l_shoulder_pitch_Pos" joint="l_shoulder_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_shoulder_roll_Pos" joint="l_shoulder_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_shoulder_yaw_Pos" joint="l_shoulder_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="l_elbow_pitch_Pos" joint="l_elbow_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <xacro:if value="${parallel_value}">
      <position name="l_wrist_yaw_Pos" joint="l_wrist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_wrist_flange_front_Pos" joint="l_wrist_flange_front" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_wrist_flange_back_Pos" joint="l_wrist_flange_back" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <position name="l_wrist_yaw_Pos" joint="l_wrist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_wrist_roll_Pos" joint="l_wrist_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="l_wrist_pitch_Pos" joint="l_wrist_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:unless>
    <position name="r_shoulder_pitch_Pos" joint="r_shoulder_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_shoulder_roll_Pos" joint="r_shoulder_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_shoulder_yaw_Pos" joint="r_shoulder_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="r_elbow_pitch_Pos" joint="r_elbow_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <xacro:if value="${parallel_value}">
      <position name="r_wrist_yaw_Pos" joint="r_wrist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_wrist_flange_front_Pos" joint="r_wrist_flange_front" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_wrist_flange_back_Pos" joint="r_wrist_flange_back" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <position name="r_wrist_yaw_Pos" joint="r_wrist_yaw" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_wrist_roll_Pos" joint="r_wrist_roll" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
      <position name="r_wrist_pitch_Pos" joint="r_wrist_pitch" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    </xacro:unless>
    <position name="neck_yaw_Pos" joint="neck_yaw" class="actuator_7" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <position name="neck_pitch_Pos" joint="neck_pitch" class="actuator_7" kp="2000" kv="0" dampratio="1.1" ctrlrange="-3.14 3.14"/>
    <xacro:if value="${parallel_value}">
      <velocity name="waist_yaw_Vel" joint="waist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_waist_flange_Vel" joint="l_waist_flange" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_waist_flange_Vel" joint="r_waist_flange" kv="0" ctrlrange="-50 50"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <velocity name="waist_yaw_Vel" joint="waist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="waist_roll_Vel" joint="waist_roll" kv="0" ctrlrange="-50 50"/>
      <velocity name="waist_pitch_Vel" joint="waist_pitch" kv="0" ctrlrange="-50 50"/>
    </xacro:unless>
    <velocity name="l_hip_pitch_Vel" joint="l_hip_pitch" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_hip_roll_Vel" joint="l_hip_roll" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_hip_yaw_Vel" joint="l_hip_yaw" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_knee_pitch_Vel" joint="l_knee_pitch" kv="0" ctrlrange="-50 50"/>
    <xacro:if value="${parallel_value}">
      <velocity name="l_ankle_flange_out_Vel" joint="l_ankle_flange_out" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_ankle_flange_in_Vel" joint="l_ankle_flange_in" kv="0" ctrlrange="-50 50"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <velocity name="l_ankle_pitch_Vel" joint="l_ankle_pitch" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_ankle_roll_Vel" joint="l_ankle_roll" kv="0" ctrlrange="-50 50"/>
    </xacro:unless>
    <velocity name="r_hip_pitch_Vel" joint="r_hip_pitch" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_hip_roll_Vel" joint="r_hip_roll" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_hip_yaw_Vel" joint="r_hip_yaw" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_knee_pitch_Vel" joint="r_knee_pitch" kv="0" ctrlrange="-50 50"/>
    <xacro:if value="${parallel_value}">
      <velocity name="r_ankle_flange_out_Vel" joint="r_ankle_flange_out" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_ankle_flange_in_Vel" joint="r_ankle_flange_in" kv="0" ctrlrange="-50 50"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <velocity name="r_ankle_pitch_Vel" joint="r_ankle_pitch" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_ankle_roll_Vel" joint="r_ankle_roll" kv="0" ctrlrange="-50 50"/>
    </xacro:unless>
    <velocity name="l_shoulder_pitch_Vel" joint="l_shoulder_pitch" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_shoulder_roll_Vel" joint="l_shoulder_roll" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_shoulder_yaw_Vel" joint="l_shoulder_yaw" kv="0" ctrlrange="-50 50"/>
    <velocity name="l_elbow_pitch_Vel" joint="l_elbow_pitch" kv="0" ctrlrange="-50 50"/>
    <xacro:if value="${parallel_value}">
      <velocity name="l_wrist_yaw_Vel" joint="l_wrist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_wrist_flange_front_Vel" joint="l_wrist_flange_front" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_wrist_flange_back_Vel" joint="l_wrist_flange_back" kv="0" ctrlrange="-50 50"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <velocity name="l_wrist_yaw_Vel" joint="l_wrist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_wrist_roll_Vel" joint="l_wrist_roll" kv="0" ctrlrange="-50 50"/>
      <velocity name="l_wrist_pitch_Vel" joint="l_wrist_pitch" kv="0" ctrlrange="-50 50"/>
    </xacro:unless>
    <velocity name="r_shoulder_pitch_Vel" joint="r_shoulder_pitch" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_shoulder_roll_Vel" joint="r_shoulder_roll" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_shoulder_yaw_Vel" joint="r_shoulder_yaw" kv="0" ctrlrange="-50 50"/>
    <velocity name="r_elbow_pitch_Vel" joint="r_elbow_pitch" kv="0" ctrlrange="-50 50"/>
    <xacro:if value="${parallel_value}">
      <velocity name="r_wrist_yaw_Vel" joint="r_wrist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_wrist_flange_front_Vel" joint="r_wrist_flange_front" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_wrist_flange_back_Vel" joint="r_wrist_flange_back" kv="0" ctrlrange="-50 50"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <velocity name="r_wrist_yaw_Vel" joint="r_wrist_yaw" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_wrist_roll_Vel" joint="r_wrist_roll" kv="0" ctrlrange="-50 50"/>
      <velocity name="r_wrist_pitch_Vel" joint="r_wrist_pitch" kv="0" ctrlrange="-50 50"/>
    </xacro:unless>
    <velocity name="neck_yaw_Vel" joint="neck_yaw" kv="0" ctrlrange="-50 50"/>
    <velocity name="neck_pitch_Vel" joint="neck_pitch" kv="0" ctrlrange="-50 50"/>
    <!-- ===================== end-effector (hand / 1dof) position actuators =====================
         Appended AFTER the 31x3 body actuator blocks (motor/position/velocity) so the existing
         body indexing (actuator_dof = body-joint count) is preserved. All names carry the
         "_HandPos" suffix; ros_controller.cpp counts them to exclude them from actuator_dof and
         drives them from the handV1 SHM command. kp/dampratio are position-control tuning values
         (validate finger stability on a sim run). End-effector joints use MuJoCo joint defaults: the
         DXL body-actuator classes (actuator_8/passive) are removed on the hand/1dof joints since no
         joint-dynamics class matches their Dynamixels (XC330-T288-T / XM430-W210-T). forcerange caps
         actuator torque (current-based-position grip, F = I_limit * Kt, I_limit=0.3A from end_effector
         setCurrentLimits): hand 0.34 Nm (XC330 Kt~1.14), 1dof 0.39 Nm (XM430-W210-T Kt~1.30). Motor-
         shaft cap; finger/gripper drive ratio not modeled. -->
    <xacro:if value="${end_effector_value == 'hand'}">
      <position name="l_0_thumb_proximal_HandPos" joint="l_0_thumb_proximal" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.727875959"/>
      <position name="l_1_thumb_middle_HandPos" joint="l_1_thumb_middle" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.221730476"/>
      <position name="l_2_thumb_distal_HandPos" joint="l_2_thumb_distal" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.570796327"/>
      <position name="l_3_index_middle_HandPos" joint="l_3_index_middle" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.570796327"/>
      <position name="l_4_index_distal_HandPos" joint="l_4_index_distal" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.570796327"/>
      <position name="l_5_middle_middle_HandPos" joint="l_5_middle_middle" kp="10" kv="0.01" forcerange="-0.34 0.34" ctrlrange="0 1.570796327"/>
