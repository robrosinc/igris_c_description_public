  </xacro:macro>
  <!-- Torso-rooted tree contents (everything below the root body). Shared by the
       free-base and fixed-base variants; only the root <body>/<freejoint> differs. -->
  <xacro:macro name="igris_c_torso_base_contents">
    <site name="base_link_imu_site" pos="0.050 0 0.047" quat="0.7071068 0 0.7071068 0" size="0.01"/>
    <inertial pos="0.00175 0.00112 0.15154" mass="12.974" fullinertia="0.15110 0.12880 0.08070 -0.00136 0.00843 -0.00089"/>
    <geom name="torso_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="torso" class="collision"/>
    <geom name="torso_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="torso" class="visual"/>
    <body name="waist_frame" pos="0.0 0.0 0.0" quat="1 0 0 0">
      <joint name="waist_yaw" type="hinge" ref="0.0" class="actuator_60" range="-1.570796327 1.570796327" axis="0 0 1"/>
      <joint name="waist_yaw_backlash" type="hinge" ref="0.0" class="slack" range="-0.005 0.005" axis="0 0 1"/>
      <inertial pos="0.02597 0 -0.00927" mass="0.208" fullinertia="0.00031 0.00031 0.00058 0.00000 0.00003 0.00000"/>
      <geom name="waist_frame_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="waist_frame" class="visual"/>
      <body name="waist_follower" pos="0.05 0 -0.026" quat="1 0 0 0">
        <xacro:if value="${parallel_value}">
          <joint name="waist_roll" type="hinge" ref="0.0" class="passive" range="-0.31 0.31" limited="true" axis="1 0 0"/>
          <joint name="waist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
        </xacro:if>
        <xacro:unless value="${parallel_value}">
          <joint name="waist_roll" type="hinge" ref="0.0" class="actuator_60" range="-0.314159265 0.314159265" axis="1 0 0"/>
          <joint name="waist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
        </xacro:unless>
        <inertial pos="0.0 0.0 -0.00829" mass="0.136" fullinertia="0.00005 0.00011 0.00007 0 0 0"/>
        <geom name="waist_follower_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="waist_follower" class="visual"/>
        <body name="pelvis" pos="0.0 0.0 -0.04" quat="1 0 0 0">
          <site name="pelvis_link_site" pos="0.050 0 0.047" quat="1 0 0 0" size="0.01"/>
          <xacro:if value="${parallel_value}">
            <joint name="waist_pitch" type="hinge" ref="0.0" class="passive" range="-0.872664626 0.287979" limited="true" axis="0 1 0"/>
            <joint name="waist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
          </xacro:if>
          <xacro:unless value="${parallel_value}">
            <joint name="waist_pitch" type="hinge" ref="0.0" class="actuator_60" range="-0.872664626 0.287979327" axis="0 1 0"/>
            <joint name="waist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
          </xacro:unless>
          <inertial pos="-0.04960 0.0 -0.05163" mass="8.124" fullinertia="0.04342 0.05156 0.04212 0.00001 0.00325 0.00000"/>
          <geom name="pelvis_collision_upper_front" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_upper_front" class="collision"/>
          <geom name="pelvis_collision_upper_back" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_upper_back" class="collision"/>
          <geom name="pelvis_collision_lower" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_lower" class="collision"/>
          <geom name="pelvis_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="pelvis" class="visual" rgba="0.9 0.9 0.9 0.3"/>
          <xacro:if value="${parallel_value}">
            <xacro:igris_c_torso_parallel_waist_block/>
          </xacro:if>
          <xacro:igris_c_legs/>
        </body>
      </body>
    </body>
    <xacro:igris_c_upper_body/>
  </xacro:macro>
  <xacro:macro name="igris_c_torso_base_block">
    <xacro:if value="${not fixed_value}">
      <body name="torso" pos="0.0 0.0 0.0" quat="1 0 0 0" childclass="robot">
        <freejoint name="floating_base"/>
        <xacro:igris_c_torso_base_contents/>
      </body>
    </xacro:if>
    <xacro:unless value="${not fixed_value}">
      <body name="torso" pos="0.0 0.0 1.5" euler="0 0.35 0" childclass="robot">
        <xacro:igris_c_torso_base_contents/>
      </body>
    </xacro:unless>
  </xacro:macro>
  <!-- Pelvis-rooted tree contents (inverted chain: torso hangs above via waist).
       Shared by free-base and fixed-base; only the root <body>/<freejoint> differs. -->
  <xacro:macro name="igris_c_pelvis_base_contents">
    <site name="pelvis_link_site" pos="0.050 0 0.047" quat="1 0 0 0" size="0.01"/>
    <inertial pos="-0.04960 0.0 -0.05163" mass="8.124" fullinertia="0.04342 0.05156 0.04212 0.00001 0.00325 0.00000"/>
    <geom name="pelvis_collision_upper_front" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_upper_front" class="collision"/>
    <geom name="pelvis_collision_upper_back" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_upper_back" class="collision"/>
    <geom name="pelvis_collision_lower" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="pelvis_lower" class="collision"/>
    <geom name="pelvis_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="pelvis" class="visual" rgba="0.9 0.9 0.9 0.3"/>
    <xacro:igris_c_legs/>
    <xacro:if value="${parallel_value}">
      <xacro:igris_c_pelvis_parallel_waist_block/>
    </xacro:if>
    <body name="waist_follower" pos="0 0 0" quat="1 0 0 0">
      <xacro:if value="${parallel_value}">
        <joint name="waist_pitch" type="hinge" ref="0.0" class="passive" range="-0.872664626 0.287979327" limited="true" axis="0 -1 0"/>
        <joint name="waist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 -1 0"/>
      </xacro:if>
      <xacro:unless value="${parallel_value}">
        <joint name="waist_pitch" type="hinge" ref="0.0" class="actuator_60" range="-0.872664626 0.287979327" axis="0 -1 0"/>
        <joint name="waist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 -1 0"/>
      </xacro:unless>
      <inertial pos="0.00000 0.00000 -0.00829" mass="0.136" fullinertia="0.00005 0.00011 0.00007 0 0 0"/>
      <geom name="waist_follower_visual" pos="0 0 0.04" quat="1 0 0 0" material="random" type="mesh" mesh="waist_follower" class="visual" rgba="${parallel_value and '0.9 0.9 0.9 0.3' or '1 1 1 1'}"/>
      <body name="waist_frame" pos="0 0 0.04" quat="1 0 0 0">
        <xacro:if value="${parallel_value}">
          <joint name="waist_roll" type="hinge" ref="0.0" class="passive" range="-0.314159265 0.314159265" limited="true" axis="-1 0 0"/>
          <joint name="waist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="-1 0 0"/>
        </xacro:if>
        <xacro:unless value="${parallel_value}">
          <joint name="waist_roll" type="hinge" ref="0.0" class="actuator_60" range="-0.314159265 0.314159265" axis="-1 0 0"/>
          <joint name="waist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="-1 0 0"/>
        </xacro:unless>
        <inertial pos="0.02597 0.00000 -0.00927" mass="0.208" fullinertia="0.00031 0.00031 0.00058 0.00000 0.00003 0.00000"/>
        <geom name="waist_frame_visual" pos="-0.05 0 0.026" quat="1 0 0 0" material="random" type="mesh" mesh="waist_frame" class="visual"/>
        <body name="torso" pos="-0.05 0 0.026" quat="1 0 0 0">
          <joint name="waist_yaw" type="hinge" ref="0.0" class="actuator_60" range="-1.570796327 1.570796327" axis="0 0 -1"/>
          <joint name="waist_yaw_backlash" type="hinge" ref="0.0" class="slack" range="-0.005 0.005" axis="0 0 -1"/>
          <site name="base_link_imu_site" pos="0.050 0 0.047" quat="0.7071068 0 0.7071068 0" size="0.01"/>
          <inertial pos="0.00175 0.00112 0.15154" mass="12.974" fullinertia="0.15110 0.12880 0.08070 -0.00136 0.00843 -0.00089"/>
          <geom name="torso_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="torso" class="collision"/>
          <geom name="torso_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="torso" class="visual"/>
          <xacro:igris_c_upper_body/>
        </body>
      </body>
    </body>
  </xacro:macro>
  <xacro:macro name="igris_c_pelvis_base_block">
    <xacro:if value="${not fixed_value}">
      <body name="pelvis" pos="0.0 0.0 0.0" quat="1 0 0 0" childclass="robot">
        <freejoint name="floating_base"/>
        <xacro:igris_c_pelvis_base_contents/>
      </body>
    </xacro:if>
    <xacro:unless value="${not fixed_value}">
      <body name="pelvis" pos="0.0 0.0 1.5" euler="0 0.35 0" childclass="robot">
        <xacro:igris_c_pelvis_base_contents/>
      </body>
    </xacro:unless>
  </xacro:macro>
  <!-- ===================== 4. Model tree (worldbody) ===================== -->
  <worldbody>
    <geom name="floor" size="10 10 .05" type="plane" material="grid" condim="3" euler="0 0. 0"/>
    <light directional="true" diffuse=".8 .8 .8" pos="0 0 10" dir="0.5 0.5 -5"/>
    <light directional="true" diffuse=".3 .3 .3" pos="10 0 0" dir="-10 0 0"/>
    <xacro:if value="${base_type_value == 'torso'}">
      <xacro:igris_c_torso_base_block/>
    </xacro:if>
    <xacro:if value="${base_type_value == 'pelvis'}">
      <xacro:igris_c_pelvis_base_block/>
    </xacro:if>
  </worldbody>
  <!-- ===================== equality ===================== -->
  <xacro:if value="${parallel_value}">
    <equality>
      <connect body1="l_waist_parallel" body2="waist_frame" anchor="0.00167 0.0035 0.05987" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      <connect body1="r_waist_parallel" body2="waist_frame" anchor="0.00167 -0.0035 0.05987" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      <xacro:unless value="${ankle_version_value == 'v2'}">
        <connect body1="l_ankle_parallel_out" body2="l_foot" anchor="0.00350 -0.00675 -0.25989" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_ankle_parallel_in" body2="l_foot" anchor="0.00350 0.00675 -0.15181" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_ankle_parallel_out" body2="r_foot" anchor="0.00350 0.00675 -0.25989" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_ankle_parallel_in" body2="r_foot" anchor="0.00350 -0.00675 -0.15181" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      </xacro:unless>
      <xacro:if value="${ankle_version_value == 'v2'}">
        <connect body1="l_ankle_parallel_out" body2="l_foot" anchor="0.00150 -0.00775 -0.25989" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_ankle_parallel_in" body2="l_foot" anchor="0.00150 0.00775 -0.15181" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_ankle_parallel_out" body2="r_foot" anchor="0.00150 0.00775 -0.25989" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_ankle_parallel_in" body2="r_foot" anchor="0.00150 -0.00775 -0.15181" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      </xacro:if>
      <!-- Two loops per side, same body pairs in both versions: the planar loop closes rod -> connector,
           the spatial loop closes connector -> parallel. Only the anchors differ, and anchor is expressed
           in body1's frame. -->
      <xacro:if value="${wrist_version_value == 'v2'}">
        <connect body1="l_wrist_rod_front" body2="l_wrist_connector_front" anchor="0 -0.00688 -0.13082" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_rod_back" body2="l_wrist_connector_back" anchor="0 -0.00688 -0.13082" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_rod_front" body2="r_wrist_connector_front" anchor="0 0.00688 -0.13082" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_rod_back" body2="r_wrist_connector_back" anchor="0 0.00688 -0.13082" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_connector_front" body2="l_wrist_parallel_front" anchor="-0.0115 0.032097 -0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_connector_back" body2="l_wrist_parallel_back" anchor="0.0115 0.032097 -0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_connector_front" body2="r_wrist_parallel_front" anchor="-0.0115 -0.032097 -0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_connector_back" body2="r_wrist_parallel_back" anchor="0.0115 -0.032097 -0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      </xacro:if>
      <xacro:unless value="${wrist_version_value == 'v2'}">
        <connect body1="l_wrist_connector_front" body2="l_wrist_parallel_front" anchor="0.0 0.03159 0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_connector_back" body2="l_wrist_parallel_back" anchor="0.0 0.03159 0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_connector_front" body2="r_wrist_parallel_front" anchor="0.0 -0.03159 0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_connector_back" body2="r_wrist_parallel_back" anchor="0.0 -0.03159 0.005098" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_rod_front" body2="l_wrist_connector_front" anchor="0.0 -0.007711 -0.123760" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="l_wrist_rod_back" body2="l_wrist_connector_back" anchor="0.0 -0.007711 -0.123760" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_rod_front" body2="r_wrist_connector_front" anchor="0.0 0.007711 -0.123760" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
        <connect body1="r_wrist_rod_back" body2="r_wrist_connector_back" anchor="0.0 0.007711 -0.123760" solimp="0.9 1.0 0.001 0.5 2" solref="0.002 1"/>
      </xacro:unless>
    </equality>
  </xacro:if>
  <!-- ===================== actuator ===================== -->
  <actuator>
    <xacro:if value="${parallel_value}">
      <motor name="waist_yaw" joint="waist_yaw" class="actuator_60"/>
      <motor name="l_waist_flange" joint="l_waist_flange" class="actuator_60"/>
      <motor name="r_waist_flange" joint="r_waist_flange" class="actuator_60"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <motor name="waist_yaw" joint="waist_yaw" class="actuator_60"/>
      <motor name="waist_roll" joint="waist_roll" class="actuator_60"/>
      <motor name="waist_pitch" joint="waist_pitch" class="actuator_60"/>
    </xacro:unless>
    <motor name="l_hip_pitch" joint="l_hip_pitch" class="actuator_150"/>
    <motor name="l_hip_roll" joint="l_hip_roll" class="actuator_120"/>
    <motor name="l_hip_yaw" joint="l_hip_yaw" class="actuator_60"/>
    <motor name="l_knee_pitch" joint="l_knee_pitch" class="actuator_150"/>
    <xacro:if value="${parallel_value}">
      <motor name="l_ankle_flange_out" joint="l_ankle_flange_out" class="actuator_90"/>
      <motor name="l_ankle_flange_in" joint="l_ankle_flange_in" class="actuator_90"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
      <motor name="l_ankle_pitch" joint="l_ankle_pitch" class="actuator_90"/>
      <motor name="l_ankle_roll" joint="l_ankle_roll" class="actuator_90"/>
    </xacro:unless>
    <motor name="r_hip_pitch" joint="r_hip_pitch" class="actuator_150"/>
    <motor name="r_hip_roll" joint="r_hip_roll" class="actuator_120"/>
    <motor name="r_hip_yaw" joint="r_hip_yaw" class="actuator_60"/>
    <motor name="r_knee_pitch" joint="r_knee_pitch" class="actuator_150"/>
    <xacro:if value="${parallel_value}">
      <motor name="r_ankle_flange_out" joint="r_ankle_flange_out" class="actuator_90"/>
      <motor name="r_ankle_flange_in" joint="r_ankle_flange_in" class="actuator_90"/>
    </xacro:if>
    <xacro:unless value="${parallel_value}">
