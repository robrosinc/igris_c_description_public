<?xml version="1.0"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="igris_c_v2">
  <!-- ===================== 0. Build parameters: xacro args + properties ===================== -->
  <xacro:arg name="base_type" default="torso"/>
  <xacro:arg name="parallel" default="false"/>
  <xacro:arg name="end_effector" default="dummy"/>
  <xacro:arg name="fixed" default="false"/>
  <xacro:arg name="ankle_version" default="v1"/>
  <xacro:arg name="wrist_version" default="v1"/>
  <xacro:property name="base_type_value" value="$(arg base_type)"/>
  <xacro:property name="end_effector_value" value="$(arg end_effector)"/>
  <xacro:property name="parallel_value" value="${'$(arg parallel)'.lower() == 'true'}"/>
  <xacro:property name="fixed_value" value="${'$(arg fixed)'.lower() == 'true'}"/>
  <!-- ankle_version: v1 = original foot (box visual), v2 = reinforced foot (mesh visual,
       heavier + shifted COM inertial, new PLA connect anchors). Collision box is unchanged. -->
  <xacro:property name="ankle_version_value" value="$(arg ankle_version)"/>
  <!-- wrist_version: v1 = intersecting roll/pitch axes, universal+hinge pair on the parallel link.
       v2 = offset roll/pitch axes, and that pair collapses into a single ball joint. Parenting and the
       equality body pairs are identical in both versions; only geometry differs. -->
  <xacro:property name="wrist_version_value" value="$(arg wrist_version)"/>
  <!-- ===================== 1. Simulation header: compiler / size / option / default / asset ===================== -->
  <compiler angle="radian" meshdir="../meshes/igris_c_v2/" balanceinertia="false"/>
  <size njmax="8000" nconmax="4000"/>
  <!-- Offscreen framebuffer for camera rendering. Must be >= the largest rendered frame or
       mjr_render silently clips; 1280x720 covers a 1280x480 stereo stitch with headroom. -->
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <!-- Sim-rate tuning (2100 Hz). timestep = 1/2100; paired with MUJOCO_DATA_DECIMATION=7 to keep
       publish at exactly 300 Hz (2100/7) and MUJOCO_COMMAND_DELAY=10 for ~5 ms latency. Must stay a
       multiple of 300 Hz; see the table in ros_controller.h.
       Lower bound: keyframe 0 has a ~5 mm geometric loop-closure residual the <connect> constraints
       cannot fully close, so timesteps above ~1/1800 diverge at startup (1/1500 flies). 2100 Hz keeps
       margin. connect/equality solref timeconst is 0.002 (>= ~2x timestep; contact solref 0.01 unchanged).
       noslip_iterations=0 (MuJoCo default): the previous value of 10 cost ~46% of step time for
       tangential-slip refinement not needed here.
       Note: dynamic (walking/impact) stability at 2100 Hz should still be validated on hardware runs. -->
  <option timestep="0.00047619048" iterations="100" tolerance="1e-7" solver="Newton" jacobian="dense" cone="elliptic" noslip_iterations="1" noslip_tolerance="1e-7"/>
  <default>
    <default class="robot">
      <default class="visual">
        <geom group="1" type="mesh" contype="0" conaffinity="0" density="0" rgba="0.9 0.9 0.9 1.0"/>
      </default>
      <default class="collision">
        <geom material="collision_material" rgba="1.0 0.28 0.1 1.0" condim="3" contype="1" conaffinity="1" priority="1" group="2" solref="0.01 1" friction="1 0.005 0.0001"/>
        <equality solimp="0.9 0.95 0.001 0.5 2" solref="0.002 1"/>
      </default>
    </default>
    <motor ctrllimited="true"/>
    <default class="actuator_150">
      <joint damping="0.5" frictionloss="0.5" limited="true" armature="0.2"/>
      <motor ctrlrange="-150.0 150.0"/>
    </default>
    <default class="actuator_120">
      <joint damping="0.5" frictionloss="2." limited="true" armature="0.12"/>
      <motor ctrlrange="-120.0 120.0"/>
    </default>
    <default class="actuator_90">
      <joint damping="0.0" frictionloss="0.1" limited="true" armature="0.1"/>
      <motor ctrlrange="-90.0 90.0"/>
    </default>
    <default class="actuator_60">
      <joint damping="0.5" frictionloss="0.54" limited="true" armature="0.019"/>
      <motor ctrlrange="-60.0 60.0"/>
    </default>
    <default class="actuator_8">
      <joint damping="0.0" frictionloss="0.264" limited="true" armature="0.01433"/>
      <motor ctrlrange="-8.0 8.0"/>
    </default>
    <default class="dynamixel_xc330_t288">
      <joint damping="0.03" frictionloss="0.001" limited="true" armature="0.01"/>
    </default>
    <default class="dynamixel_xm430_w210">
      <joint damping="0.03" frictionloss="0.001" limited="true" armature="0.01"/>
    </default>
    <default class="actuator_7">
      <joint damping="1.0" frictionloss="0.356" limited="true" armature="0.2488"/>
      <motor ctrlrange="-7.0 7.0"/>
    </default>
    <default class="passive">
      <joint damping="0.001" frictionloss="1e-4" limited="false" armature="1e-6"/>
    </default>
    <default class="slack">
      <joint damping="0.001" frictionloss="1e-4" limited="true" armature="1e-6"/>
    </default>
  </default>
  <asset>
    <material name="random" rgba="0.0706 0.0706 0.0706 0.7"/>
    <material name="default_material" rgba="0.7 0.7 0.7 1"/>
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9"/>
    <mesh name="torso" file="torso.stl" scale="0.01 0.01 0.01"/>
    <mesh name="waist_frame" file="waist_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="waist_follower" file="waist_follower.stl" scale="0.01 0.01 0.01"/>
    <mesh name="pelvis" file="pelvis.stl" scale="0.01 0.01 0.01"/>
    <mesh name="pelvis_upper_front" file="pelvis_upper_front.stl" scale="0.01 0.01 0.01"/>
    <mesh name="pelvis_upper_back" file="pelvis_upper_back.stl" scale="0.01 0.01 0.01"/>
    <mesh name="pelvis_lower" file="pelvis_lower.stl" scale="0.01 0.01 0.01"/>
    <mesh name="neck" file="neck.stl" scale="0.01 0.01 0.01"/>
    <mesh name="head" file="head.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_hip_frame" file="l_hip_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_hip_bracket" file="l_hip_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_hip_yaw_collision" file="upper_leg_collision.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_upper_leg" file="l_upper_leg.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_lower_leg" file="l_lower_leg.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_frame" file="l_ankle_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_foot_v1" file="l_foot_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_foot_v2" file="l_foot_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_hip_frame" file="r_hip_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_hip_bracket" file="r_hip_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_hip_yaw_collision" file="upper_leg_collision.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_upper_leg" file="r_upper_leg.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_lower_leg" file="r_lower_leg.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_ankle_frame" file="r_ankle_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_foot_v1" file="r_foot_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_foot_v2" file="r_foot_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_shoulder_frame" file="l_shoulder_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_shoulder_bracket" file="l_shoulder_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_upper_arm" file="l_upper_arm.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_elbow_bracket" file="l_elbow_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_forearm" file="l_forearm.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_coupler_v1" file="l_wrist_coupler_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_mount_v1" file="l_wrist_mount_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_shoulder_frame" file="r_shoulder_frame.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_shoulder_bracket" file="r_shoulder_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_upper_arm" file="r_upper_arm.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_elbow_bracket" file="r_elbow_bracket.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_forearm" file="r_forearm.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_coupler_v1" file="r_wrist_coupler_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_mount_v1" file="r_wrist_mount_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_waist_flange" file="l_waist_flange.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_waist_flange" file="r_waist_flange.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_waist_parallel" file="l_waist_parallel.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_waist_parallel" file="r_waist_parallel.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_flange_out" file="l_ankle_flange_out.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_flange_in" file="l_ankle_flange_in.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_parallel_out" file="l_ankle_parallel_out.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_ankle_parallel_in" file="l_ankle_parallel_in.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_ankle_flange_out" file="r_ankle_flange_out.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_ankle_flange_in" file="r_ankle_flange_in.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_ankle_parallel_out" file="r_ankle_parallel_out.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_ankle_parallel_in" file="r_ankle_parallel_in.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_front_v1" file="l_wrist_connector_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_back_v1" file="l_wrist_connector_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_parallel_front_v1" file="l_wrist_parallel_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_parallel_back_v1" file="l_wrist_parallel_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_universal_front_v1" file="l_wrist_universal_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_universal_back_v1" file="l_wrist_universal_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_front_v1" file="r_wrist_connector_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_back_v1" file="r_wrist_connector_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_front_v1" file="r_wrist_parallel_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_back_v1" file="r_wrist_parallel_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_universal_front_v1" file="r_wrist_universal_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_universal_back_v1" file="r_wrist_universal_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_front_v1" file="l_wrist_flange_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_front_v1" file="l_wrist_rod_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_back_v1" file="l_wrist_flange_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_back_v1" file="l_wrist_rod_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_front_v1" file="r_wrist_flange_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_front_v1" file="r_wrist_rod_front_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_back_v1" file="r_wrist_flange_back_v1.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_back_v1" file="r_wrist_rod_back_v1.stl" scale="0.01 0.01 0.01"/>
    <!-- v2 wrist meshes. Declared unconditionally, matching the foot_v1/foot_v2 pair. -->
    <mesh name="l_wrist_coupler_v2" file="l_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_mount_v2" file="l_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_front_v2" file="l_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_connector_back_v2" file="l_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_front_v2" file="l_wrist_flange_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_flange_back_v2" file="l_wrist_flange_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_front_v2" file="l_wrist_rod_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_rod_back_v2" file="l_wrist_rod_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_parallel_front_v2" file="l_wrist_parallel_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="l_wrist_parallel_back_v2" file="l_wrist_parallel_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_coupler_v2" file="r_wrist_coupler_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_mount_v2" file="r_wrist_mount_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_front_v2" file="r_wrist_connector_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_connector_back_v2" file="r_wrist_connector_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_front_v2" file="r_wrist_flange_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_flange_back_v2" file="r_wrist_flange_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_front_v2" file="r_wrist_rod_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_rod_back_v2" file="r_wrist_rod_back_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_front_v2" file="r_wrist_parallel_front_v2.stl" scale="0.01 0.01 0.01"/>
    <mesh name="r_wrist_parallel_back_v2" file="r_wrist_parallel_back_v2.stl" scale="0.01 0.01 0.01"/>
    <texture type="skybox" builtin="gradient" width="128" height="128" rgb1="1.0 1.0 1.0" rgb2="0.4 0.4 0.4"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.9 0.9 0.9" rgb2=".85 .85 .85"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <!-- end_effector meshes: declared only for the selected end_effector. -->
    <xacro:if value="${end_effector_value == 'hand'}">
      <mesh name="l_palm" file="../igris_c_end_effector/hand/l_palm.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_palm" file="../igris_c_end_effector/hand/r_palm.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_proximal" file="../igris_c_end_effector/hand/l_thumb_proximal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_middle" file="../igris_c_end_effector/hand/l_thumb_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_thumb_distal" file="../igris_c_end_effector/hand/l_thumb_distal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_proximal" file="../igris_c_end_effector/hand/r_thumb_proximal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_middle" file="../igris_c_end_effector/hand/r_thumb_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_thumb_distal" file="../igris_c_end_effector/hand/r_thumb_distal.stl" scale="0.01 0.01 0.01"/>
      <mesh name="finger_middle" file="../igris_c_end_effector/hand/finger_middle.stl" scale="0.01 0.01 0.01"/>
      <mesh name="finger_distal" file="../igris_c_end_effector/hand/finger_distal.stl" scale="0.01 0.01 0.01"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'magnet'}">
      <mesh name="l_magnet" file="../igris_c_end_effector/magnet/l_magnet_gripper.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_magnet" file="../igris_c_end_effector/magnet/r_magnet_gripper.stl" scale="0.01 0.01 0.01"/>
    </xacro:if>
    <xacro:if value="${end_effector_value == '1dof'}">
      <mesh name="l_1_dof_gripper_fixed" file="../igris_c_end_effector/1_dof_gripper/l_1_dof_gripper_fixed.stl" scale="0.01 0.01 0.01"/>
      <mesh name="l_1_dof_gripper_moving" file="../igris_c_end_effector/1_dof_gripper/l_1_dof_gripper_moving.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_1_dof_gripper_fixed" file="../igris_c_end_effector/1_dof_gripper/r_1_dof_gripper_fixed.stl" scale="0.01 0.01 0.01"/>
      <mesh name="r_1_dof_gripper_moving" file="../igris_c_end_effector/1_dof_gripper/r_1_dof_gripper_moving.stl" scale="0.01 0.01 0.01"/>
    </xacro:if>
  </asset>
  <!-- ===================== 2. Reusable macro definitions ===================== -->
  <xacro:include filename="igris_c_lowerarm_module.xml.xacro"/>
  <!-- Foot inertial + geometry (ankle_version v1/v2 inline). Shared by the parallel
       and serial ankle so the version difference lives in one place per side. -->
  <xacro:macro name="igris_c_l_foot">
    <xacro:if value="${ankle_version_value == 'v2'}">
      <!-- v2: reinforced foot - heavier, shifted COM, mesh visual -->
      <inertial pos="0.01282 0.00000 -0.04623" mass="0.634" fullinertia="0.00073 0.00256 0.00244 0.00000 0.00047 0.00000"/>
      <geom name="l_foot_collision" pos="0.048 0 -0.0685" quat="1 0 0 0" type="box" size="0.1 0.035 0.0025" class="collision" rgba="0.1 0.1 0.1 1"/>
      <geom name="l_foot_visual" pos="0.0 0.0 0.0" quat="1 0 0 0" type="mesh" mesh="l_foot_v2" class="visual"/>
    </xacro:if>
    <xacro:unless value="${ankle_version_value == 'v2'}">
      <!-- v1: original foot - mesh visual, box collision -->
      <inertial pos="0.02167 0.00000 -0.05193" mass="0.579" fullinertia="0.00045 0.00166 0.00158 0.00000 0.00024 0.00000"/>
      <geom name="l_foot_collision" pos="0.048 0 -0.0685" quat="1 0 0 0" type="box" size="0.1 0.035 0.0025" class="collision" rgba="0.1 0.1 0.1 1"/>
      <geom name="l_foot_visual" pos="0.0 0.0 0.0" quat="1 0 0 0" type="mesh" mesh="l_foot_v1" class="visual"/>
    </xacro:unless>
  </xacro:macro>
  <!-- Foot inertial + geometry (ankle_version v1/v2 inline). Shared by the parallel
       and serial ankle so the version difference lives in one place per side. -->
  <xacro:macro name="igris_c_r_foot">
    <xacro:if value="${ankle_version_value == 'v2'}">
      <!-- v2: reinforced foot - heavier, shifted COM, mesh visual -->
      <inertial pos="0.01282 0.00000 -0.04623" mass="0.634" fullinertia="0.00073 0.00256 0.00244 0.00000 0.00047 0.00000"/>
      <geom name="r_foot_collision" pos="0.048 0 -0.0685" quat="1 0 0 0" type="box" size="0.1 0.035 0.0025" class="collision" rgba="0.1 0.1 0.1 1"/>
      <geom name="r_foot_visual" pos="0.0 0.0 0.0" quat="1 0 0 0" type="mesh" mesh="r_foot_v2" class="visual"/>
    </xacro:if>
    <xacro:unless value="${ankle_version_value == 'v2'}">
      <!-- v1: original foot - mesh visual, box collision -->
      <inertial pos="0.02167 0.00000 -0.05193" mass="0.579" fullinertia="0.00045 0.00166 0.00158 0.00000 0.00024 0.00000"/>
      <geom name="r_foot_collision" pos="0.048 0 -0.0685" quat="1 0 0 0" type="box" size="0.1 0.035 0.0025" class="collision" rgba="0.1 0.1 0.1 1"/>
      <geom name="r_foot_visual" pos="0.0 0.0 0.0" quat="1 0 0 0" type="mesh" mesh="r_foot_v1" class="visual"/>
    </xacro:unless>
  </xacro:macro>
  <!-- Full l ankle: parallel (4-bar linkage, passive joints) or serial (actuator_90)
       per parallel_value. Shared foot inertial/geometry via igris_c_l_foot. -->
  <xacro:macro name="igris_c_l_ankle">
    <xacro:if value="${parallel_value}">
      <body name="l_ankle_frame" pos="0.005 0 -0.34" quat="1 0 0 0">
        <joint name="l_ankle_pitch" type="hinge" ref="0.0" class="passive" range="-0.698131701 0.698131701" limited="true" axis="0 1 0"/>
        <joint name="l_ankle_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
        <inertial pos="0 0 0" mass="0.084" fullinertia="3e-05 2e-05 3e-05 0 0 0"/>
