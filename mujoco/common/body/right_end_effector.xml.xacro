<?xml version="1.0"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Shared by igris_c and igris_max (model trees link here). Right end effector variants: five-finger hand, magnet, 1-DoF gripper (end_effector:=hand|magnet|1dof). Included inside r_wrist_mount by body/right_arm. -->
  <!-- ===================== Hand (end_effector:=hand) ===================== -->
  <xacro:if value="${end_effector_value == 'hand'}">
    <body name="r_palm" pos="0 -0.0109 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" quat="1 0 0 0">
      <inertial pos="-0.00142495166 -0.000962113834 -0.042669833" mass="0.200" fullinertia="0.000124202749 0.00022693325 0.000140421816 4.41775453e-06 8.95918296e-06 -9.99611275e-06"/>
      <geom name="r_palm_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_palm" class="collision"/>
      <geom name="r_palm_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_palm" class="visual"/>
      <!-- Camera: see the hand variant in left_end_effector.xml.xacro. -->
      <frame name="right_hand_camera" pos="-0.024420 0.010317 -0.034793" quat="0.222070397 0.111732396 0.871911698 0.421865621">
        <camera name="right_hand_camera" mode="fixed" resolution="640 480" quat="0 1 0 0"/>
      </frame>
      <body name="r_thumb_proximal" pos="0.026 0.0132 -0.0299" quat="-0.043619 0.999048 0 0">
        <joint name="r_0_thumb_proximal" class="dynamixel_xc330_t288" axis="0 0 1" range="-1.727875959 0"/>
        <inertial pos="0.00736769377 -3.27348285e-05 0.0103021585" mass="0.01" fullinertia="8.13726421e-07 1.65173834e-06 1.76040561e-06 3.58115493e-09 -2.29167106e-07 1.66159259e-09"/>
        <geom name="r_thumb_proximal_collision" type="mesh" mesh="r_thumb_proximal" class="collision"/>
        <geom name="r_thumb_proximal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="r_thumb_proximal" class="visual"/>
        <body name="r_thumb_middle" pos="0.0230 -0.0036 0.015" quat="0.579228 -0.405580 0.405580 -0.579228">
          <joint name="r_1_thumb_middle" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.221730476"/>
          <inertial pos="-0.00152976401 -0.000579208741 0.0206296751" mass="0.008" fullinertia="1.48552501e-06 1.62192224e-06 5.45604072e-07 8.6328696e-09 -1.27929572e-07 4.9554149e-08"/>
          <geom name="r_thumb_middle_collision" type="mesh" mesh="r_thumb_middle" class="collision"/>
          <geom name="r_thumb_middle_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="r_thumb_middle" class="visual"/>
          <body name="r_thumb_distal" pos="0 -0.001 0.04" quat="1 0 0 0">
            <joint name="r_2_thumb_distal" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
            <inertial pos="-9.72659277e-05 -0.000417499913 0.0168844834" mass="0.006" fullinertia="9.08378995e-07 9.39210618e-07 2.67938784e-07 -4.45944266e-10 -1.02627643e-08 -3.13436371e-08"/>
            <geom name="r_thumb_distal_collision" type="mesh" mesh="r_thumb_distal" class="collision"/>
            <geom name="r_thumb_distal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="r_thumb_distal" class="visual"/>
          </body>
        </body>
      </body>
      <body name="r_index_middle" pos="0.0305 -0.002 -0.101" quat="0 1 0 0">
        <joint name="r_3_index_middle" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
        <inertial pos="-2.12973158e-06 -0.000606375566 0.019772219" mass="0.008" fullinertia="1.76481614e-06 1.813998e-06 4.34815829e-07 -4.6203336e-11 4.76122273e-11 5.15864199e-08"/>
        <geom name="r_index_middle_collision" type="mesh" mesh="finger_middle" class="collision"/>
        <geom name="r_index_middle_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_middle" class="visual"/>
        <body name="r_index_distal" pos="0 -0.001 0.04" quat="1 0 0 0">
          <joint name="r_4_index_distal" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
          <inertial pos="7.55064321e-07 -0.000539511032 0.0179878452" mass="0.006" fullinertia="8.75037334e-07 8.98295706e-07 2.69543245e-07 -5.88858205e-11 -2.62959743e-10 -2.7494979e-08"/>
          <geom name="r_index_distal_collision" type="mesh" mesh="finger_distal" class="collision"/>
          <geom name="r_index_distal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_distal" class="visual"/>
        </body>
      </body>
      <body name="r_middle_middle" pos="0.0085 -0.002 -0.101" quat="0 1 0 0">
        <joint name="r_5_middle_middle" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
        <inertial pos="-2.12973158e-06 -0.000606375566 0.019772219" mass="0.008" fullinertia="1.76481614e-06 1.813998e-06 4.34815829e-07 -4.6203336e-11 4.76122273e-11 5.15864199e-08"/>
        <geom name="r_middle_middle_collision" type="mesh" mesh="finger_middle" class="collision"/>
        <geom name="r_middle_middle_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_middle" class="visual"/>
        <body name="r_middle_distal" pos="0 -0.001 0.04" quat="1 0 0 0">
          <joint name="r_6_middle_distal" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
          <inertial pos="7.55064321e-07 -0.000539511032 0.0179878452" mass="0.006" fullinertia="8.75037334e-07 8.98295706e-07 2.69543245e-07 -5.88858205e-11 -2.62959743e-10 -2.7494979e-08"/>
          <geom name="r_middle_distal_collision" type="mesh" mesh="finger_distal" class="collision"/>
          <geom name="r_middle_distal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_distal" class="visual"/>
        </body>
      </body>
      <body name="r_ring_middle" pos="-0.0139 -0.001 -0.099" quat="0.000305 0.999695 -0.01745 -0.01745">
        <joint name="r_7_ring_middle" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
        <inertial pos="-2.12973158e-06 -0.000606375566 0.019772219" mass="0.008" fullinertia="1.76481614e-06 1.813998e-06 4.34815829e-07 -4.6203336e-11 4.76122273e-11 5.15864199e-08"/>
        <geom name="r_ring_middle_collision" type="mesh" mesh="finger_middle" class="collision"/>
        <geom name="r_ring_middle_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_middle" class="visual"/>
        <body name="r_ring_distal" pos="0 -0.001 0.04" quat="1 0 0 0">
          <joint name="r_8_ring_distal" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
          <inertial pos="7.55064321e-07 -0.000539511032 0.0179878452" mass="0.006" fullinertia="8.75037334e-07 8.98295706e-07 2.69543245e-07 -5.88858205e-11 -2.62959743e-10 -2.7494979e-08"/>
          <geom name="r_ring_distal_collision" type="mesh" mesh="finger_distal" class="collision"/>
          <geom name="r_ring_distal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_distal" class="visual"/>
        </body>
      </body>
      <body name="r_little_middle" pos="-0.0362 0.0012 -0.0942" quat="0.000228 0.998706 -0.026168 -0.043612">
        <joint name="r_9_little_middle" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
        <inertial pos="-2.12973158e-06 -0.000606375566 0.019772219" mass="0.008" fullinertia="1.76481614e-06 1.813998e-06 4.34815829e-07 -4.6203336e-11 4.76122273e-11 5.15864199e-08"/>
        <geom name="r_little_middle_collision" type="mesh" mesh="finger_middle" class="collision"/>
        <geom name="r_little_middle_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_middle" class="visual"/>
        <body name="r_little_distal" pos="0 -0.001 0.04" quat="1 0 0 0">
          <joint name="r_10_little_distal" class="dynamixel_xc330_t288" axis="1 0 0" range="0 1.570796327"/>
          <inertial pos="7.55064321e-07 -0.000539511032 0.0179878452" mass="0.006" fullinertia="8.75037334e-07 8.98295706e-07 2.69543245e-07 -5.88858205e-11 -2.62959743e-10 -2.7494979e-08"/>
          <geom name="r_little_distal_collision" type="mesh" mesh="finger_distal" class="collision"/>
          <geom name="r_little_distal_visual" type="mesh" rgba="0.5 0.5 0.5 1" mesh="finger_distal" class="visual"/>
        </body>
      </body>
    </body>
  </xacro:if>
  <!-- ===================== Magnet (end_effector:=magnet) ===================== -->
  <xacro:if value="${end_effector_value == 'magnet'}">
    <!-- See the magnet section of urdf/<model>/body/right_end_effector.urdf.xacro for the inertial
         provenance. The branch this came from dropped the off-diagonal iyz in its fullinertia; it is kept here. -->
    <body name="r_magnet" pos="0 0 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" quat="1 0 0 0">
      <inertial pos="-0.00005 -0.02385 -0.05845" mass="0.244" fullinertia="0.00036 0.00025 0.00024 0 0 -0.00005"/>
      <geom name="r_magnet_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_magnet" class="collision"/>
      <geom name="r_magnet_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_magnet" material="random" class="visual"/>
      <!-- Camera: see the magnet variant in left_end_effector.xml.xacro. -->
      <frame name="right_hand_camera" pos="0.00001126 -0.00372014 -0.10086950" quat="0 0 -0.707106781 -0.707106781">
        <camera name="right_hand_camera" mode="fixed" resolution="640 480" quat="0 1 0 0"/>
      </frame>
      <!-- Rotating magnet head, the motor DOF added on top of the electromagnet. The joint frame
           is the CAD one (45 deg about x); igris_c_hand drives it on slot 1 (right, id 12) / slot 7
           (left, id 22), while the electromagnet itself is the binary slot 0 / 6. -->
      <body name="r_magnet_head" pos="0 0.019856853 -0.070583262" quat="0.923879564 0.382683357 0 0">
        <!-- One-sided limits, mirrored L/R, exactly as the 1-dof gripper does it: zero is
             one end of travel and the sign of the span says which way the side turns. The
             igris_c_mujoco hand mapping derives q=0 from the limit nearest zero, so this is
             what makes a single q command move both heads as mirror images, matching the
             mirrored servo mounting (ids 12 / 22). 340 deg total; igris_c_hand carries no
             direction sign of its own - it calibrates against the physical stops. -->
        <joint name="r_magnet_rotate" class="dynamixel_xm430_w210" axis="0 0 1" range="0 5.93412"/>
        <inertial pos="-0.00010 0.00000 -0.01252" mass="0.175" fullinertia="0.00003 0.00003 0.00004 0 0 0"/>
        <geom name="r_magnet_head_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_magnet_head" class="collision"/>
        <!-- Working face of the electromagnet, flush with the mesh face at z=-0.025.
             A BOX, although the real pole face is a 40 mm circle: MuJoCo's cylinder-box
             collider yields a single contact point, which the target pivots off (measured:
             0 kgf for a cylinder face against 25 kgf for this box). Box-box yields the
             4-point manifold the hold needs. The size is the square INSCRIBED in that
             circle (28.28 mm across, 20/sqrt(2) half-extent), so the face never reaches
             outside the real pole; the hold does not depend on its area anyway - MuJoCo
             splits the actuator's gain across whatever contacts exist.
             margin/gap give the actuator its reach, about margin - 2 mm: 8 mm here pulls a
             target in across a 6 mm gap. gap=margin keeps the band force-free, so ordinary
             collision is unchanged. -->
        <geom name="r_magnet_face" type="box" size="0.014142 0.014142 0.002" pos="0 0 -0.023" class="collision" margin="0.008" gap="0.008"/>
        <geom name="r_magnet_head_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_magnet_head" material="random" class="visual"/>
      </body>
    </body>
  </xacro:if>
  <!-- ===================== 1-DoF gripper (end_effector:=1dof) ===================== -->
  <xacro:if value="${end_effector_value == '1dof'}">
    <body name="r_1_dof_gripper_fixed" pos="0 0 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" quat="1 0 0 0">
      <inertial pos="0.00396 -0.00377 -0.05310" mass="0.271" fullinertia="0.00033 0.00040 0.00021 0.00001 -0.00003 0.00004"/>
      <geom name="r_1_dof_gripper_fixed_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_fixed" class="collision"/>
      <geom name="r_1_dof_gripper_fixed_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_fixed" material="random" class="visual"/>
      <!-- Camera: see the 1dof variant in left_end_effector.xml.xacro. -->
      <frame name="right_hand_camera" pos="0.050416 -0.020241 -0.052538" quat="0.281585153 0.643645333 -0.711438481 0.016904878">
        <camera name="right_hand_camera" mode="fixed" resolution="640 480" quat="0 1 0 0"/>
      </frame>
      <!-- rest (q=0) = open: body pre-rolled by -travel (quat=-100deg about X) and axis flipped so q increases toward closed -->
      <body name="r_1_dof_gripper_moving" pos="0 -0.02625 -0.04225" quat="0.642788 -0.766044 0 0">
        <joint name="r_1_dof_gripper_moving" type="hinge" ref="0.0" class="dynamixel_xm430_w210" range="-1.74533 0" limited="true" axis="-1 0 0"/>
        <inertial pos="-0.00028 0.00857 -0.04908" mass="0.093" fullinertia="0.00007 0.00009 0.00004 0.00000 0.00000 0.00001"/>
        <geom name="r_1_dof_gripper_moving_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_moving" class="collision"/>
        <geom name="r_1_dof_gripper_moving_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_moving" material="random" class="visual"/>
      </body>
    </body>
  </xacro:if>
</mujoco>
