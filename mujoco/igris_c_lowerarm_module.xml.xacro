  <xacro:macro name="igris_c_l_magnet_end_effector_block">
    <body name="l_magnet" pos="0 0 ${-0.02855 if wrist_version_value == 'v2' else -0.024}" quat="1 0 0 0">
      <inertial pos="0.00006 0.00281 -0.06784" mass="0.427" fullinertia="0.00074 0.00034 0.00057 0 0 -0.00005"/>
      <geom name="l_magnet_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="l_magnet" class="collision"/>
      <geom name="l_magnet_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="l_magnet" material="random" class="visual"/>
      <!-- Extrinsics mirror left_hand_camera_link in urdf/igris_c_lowerarm_module.urdf.xacro.
           Name shared with the hand and 1dof blocks; see the hand block for why that is unique.
           The magnet CAD export does NOT use the ROS-optical mapping the 1dof camera does; the
           resulting axes are stated in the URDF block, expressed in the MAGNET LINK frame. Do
           not compare that statement term by term with a CAD-export-frame one: they are two
           different reference frames. resolution = camera.yaml hand_mono output_resolution;
           fovy stays at the MuJoCo default because this lens is unmeasured.
           UNVERIFIED, same caveat as the URDF block: this view axis runs across the gripper
           body rather than out along the approach axis, and the magnet variant has no
           counterpart in the reference model to cross-check. Confirm in the viewer. -->
      <frame name="left_hand_camera" pos="-0.00001126 0.00372014 -0.10086950" quat="0.707106781 0.707106781 0 0">
        <camera name="left_hand_camera" mode="fixed" resolution="640 480" quat="0 1 0 0"/>
      </frame>
    </body>
  </xacro:macro>
  <xacro:macro name="igris_c_l_1dof_gripper_end_effector_block">
