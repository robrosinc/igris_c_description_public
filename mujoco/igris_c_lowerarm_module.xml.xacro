<?xml version="1.0"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="igris_c_no_end_effector_block"/>
  <!-- The wrist range limits are load-bearing stops of the four-bar, so they carry solreflimit;
       MuJoCo's default is too soft and lets an impact push them out of fk()'s solvable range.
       See README "Wrist joint-limit stiffness". -->
  <xacro:macro name="igris_c_l_parallel_wrist_forearm_block">
    <!-- v2: planar four-bar (flange -> rod) plus the spatial four-bar crank (connector), whose loop
         closes against the parallel link carried by the mount. Body and joint names match v1, so the
         actuator, position and velocity lists stay version-agnostic. -->
    <xacro:if value="${wrist_version_value == 'v2'}">
      <body name="l_wrist_flange_front" pos="0.0125 0.000 -0.0845" quat="1 0 0 0">
        <joint name="l_wrist_flange_front" type="hinge" ref="0.0" class="actuator_8" range="-0.81 0.81" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
        <inertial pos="-0.002877 0.00917 -0.001436" mass="0.009769" fullinertia="0.000002534828 0.00000064386 0.000001949949 0.000000106622 -0.000000016697 0.000000209669"/>
        <geom name="l_wrist_flange_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_flange_front_v2" class="visual"/>
        <body name="l_wrist_rod_front" pos="-0.0085 0.029639 -0.004658" quat="1 0 0 0">
          <joint name="l_wrist_rod_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="0 -0.003428 -0.06541" mass="0.016515" fullinertia="0.000036352855 0.000036074026 0.000000397898 0 0 -0.000001874856"/>
          <geom name="l_wrist_rod_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_rod_front_v2" class="visual"/>
        </body>
      </body>
      <body name="l_wrist_flange_back" pos="-0.0125 0.000 -0.0845" quat="1 0 0 0">
        <joint name="l_wrist_flange_back" type="hinge" ref="0.0" class="actuator_8" range="-0.81 0.81" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
        <inertial pos="0.002877 0.00917 -0.001436" mass="0.009769" fullinertia="0.000002534828 0.00000064386 0.000001949949 -0.000000106622 0.000000016697 0.00000020967"/>
        <geom name="l_wrist_flange_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_flange_back_v2" class="visual"/>
        <body name="l_wrist_rod_back" pos="0.0085 0.029639 -0.004658" quat="1 0 0 0">
          <joint name="l_wrist_rod_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="0 -0.003428 -0.06541" mass="0.016515" fullinertia="0.000036352855 0.000036074026 0.000000397898 0 0 -0.000001874856"/>
          <geom name="l_wrist_rod_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_rod_back_v2" class="visual"/>
        </body>
      </body>
      <body name="l_wrist_connector_front" pos="0.02900 -0.009341 -0.21488" quat="1 0 0 0">
        <joint name="l_wrist_connector_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
        <inertial pos="-0.012246 0.013095 -0.002074" mass="0.01031" fullinertia="0.000001546284 0.000000542679 0.000001766002 0.000000621838 -0.000000098489 0.000000198741"/>
        <geom name="l_wrist_connector_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_connector_front_v2" class="visual"/>
      </body>
      <body name="l_wrist_connector_back" pos="-0.02900 -0.009341 -0.21488" quat="1 0 0 0">
        <joint name="l_wrist_connector_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
        <inertial pos="0.012246 0.013095 -0.002074" mass="0.01031" fullinertia="0.000001546284 0.000000542679 0.000001766002 -0.000000621838 0.000000098489 0.000000198741"/>
        <geom name="l_wrist_connector_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_connector_back_v2" class="visual"/>
      </body>
    </xacro:if>
    <xacro:unless value="${wrist_version_value == 'v2'}">
      <body name="l_wrist_flange_front" pos="0.004 0 -0.08450" quat="1 0 0 0">
        <joint name="l_wrist_flange_front" type="hinge" ref="0.0" class="actuator_8" range="-0.98 0.75" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
        <inertial pos="-0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
        <geom name="l_wrist_flange_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_flange_front_v1" class="visual"/>
        <body name="l_wrist_rod_front" pos="0.0 0.029961 -0.001522" quat="1 0 0 0">
          <joint name="l_wrist_rod_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="-0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
          <geom name="l_wrist_rod_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_rod_front_v1" class="visual"/>
        </body>
      </body>
      <body name="l_wrist_flange_back" pos="-0.004 0 -0.08450" quat="1 0 0 0">
        <joint name="l_wrist_flange_back" type="hinge" ref="0.0" class="actuator_8" range="-0.98 0.75" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
        <inertial pos="0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
        <geom name="l_wrist_flange_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_flange_back_v1" class="visual"/>
        <body name="l_wrist_rod_back" pos="0.0 0.029961 -0.001522" quat="1 0 0 0">
          <joint name="l_wrist_rod_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
          <geom name="l_wrist_rod_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_rod_back_v1" class="visual"/>
        </body>
      </body>
      <body name="l_wrist_connector_front" pos="0.02000 -0.009341 -0.21488" quat="1 0 0 0">
        <joint name="l_wrist_connector_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
        <inertial pos="-0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
        <geom name="l_wrist_connector_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_connector_front_v1" class="visual"/>
      </body>
      <body name="l_wrist_connector_back" pos="-0.02000 -0.009341 -0.21488" quat="1 0 0 0">
        <joint name="l_wrist_connector_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
        <inertial pos="0.00357 0.01879 0.00461" mass="0.009" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
        <geom name="l_wrist_connector_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_connector_back_v1" class="visual"/>
      </body>
    </xacro:unless>
  </xacro:macro>
  <xacro:macro name="igris_c_l_parallel_wrist_mount_block">
    <!-- v2 merges the v1 universal+hinge pair into one ball joint; the parenting is unchanged. -->
    <xacro:if value="${wrist_version_value == 'v2'}">
      <body name="l_wrist_parallel_front" pos="0.021 0.02025 -0.01675" quat="1 0 0 0">
        <joint name="l_wrist_parallel_front" type="ball" ref="0.0" class="passive"/>
        <inertial pos="0.00135 0.010135 0.022592" mass="0.013631" fullinertia="0.000004968614 0.000004480709 0.000000791828 -0.000000066531 0.000000336696 -0.00000061995"/>
        <geom name="l_wrist_parallel_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_parallel_front_v2" class="visual"/>
      </body>
      <body name="l_wrist_parallel_back" pos="-0.021 0.02025 -0.01675" quat="1 0 0 0">
        <joint name="l_wrist_parallel_back" type="ball" ref="0.0" class="passive"/>
        <inertial pos="-0.00135 0.010135 0.022592" mass="0.013631" fullinertia="0.000004968614 0.000004480709 0.000000791828 0.000000066531 -0.000000336696 -0.00000061995"/>
        <geom name="l_wrist_parallel_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_parallel_back_v2" class="visual"/>
      </body>
    </xacro:if>
    <xacro:unless value="${wrist_version_value == 'v2'}">
      <body name="l_wrist_universal_front" pos="0.01000 0.02150 -0.01000" quat="1 0 0 0">
        <joint name="l_wrist_universal_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="0 1 0"/>
        <inertial pos="0.00000 -0.00189 -0.00004" mass="0.005" fullinertia="0.000001 0.000001 0.000001 0 0 0"/>
        <geom name="l_wrist_universal_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_universal_front_v1" class="visual"/>
        <body name="l_wrist_parallel_front" pos="0 0 0" quat="1 0 0 0">
          <joint name="l_wrist_parallel_front" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="-0.00094 -0.00038 -0.01026" mass="0.017" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
          <geom name="l_wrist_parallel_front_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_parallel_front_v1" class="visual"/>
        </body>
      </body>
      <body name="l_wrist_universal_back" pos="-0.01000 0.02150 -0.01000" quat="1 0 0 0">
        <joint name="l_wrist_universal_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="0 1 0"/>
        <inertial pos="0.00000 -0.00189 -0.00004" mass="0.002" fullinertia="0.00001 0.00001 0.00001 0.00000 0.00000 0.00000"/>
        <geom name="l_wrist_universal_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_universal_back_v1" class="visual"/>
        <body name="l_wrist_parallel_back" pos="0 0 0" quat="1 0 0 0">
          <joint name="l_wrist_parallel_back" type="hinge" ref="0.0" class="passive" range="-1.57 1.57" axis="1 0 0"/>
          <inertial pos="0.00094 -0.00038 -0.01026" mass="0.017" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
          <geom name="l_wrist_parallel_back_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_parallel_back_v1" class="visual"/>
        </body>
      </body>
    </xacro:unless>
  </xacro:macro>
