        <geom name="r_1_dof_gripper_moving_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_moving" class="collision"/>
        <geom name="r_1_dof_gripper_moving_visual" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_1_dof_gripper_moving" material="random" class="visual"/>
      </body>
    </body>
  </xacro:macro>
  <!-- End-effector payload plus the parallel mount block; identical across wrist versions. -->
  <xacro:macro name="igris_c_l_wrist_payload_block">
    <xacro:if value="${end_effector_value == 'hand' and not parallel}">
    </xacro:if>
    <xacro:if value="${end_effector_value == 'none'}">
      <xacro:igris_c_no_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'hand'}">
      <xacro:igris_c_l_hand_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'magnet'}">
      <xacro:igris_c_l_magnet_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == '1dof'}">
      <xacro:igris_c_l_1dof_gripper_end_effector_block/>
    </xacro:if>
    <xacro:if value="${parallel}">
      <xacro:igris_c_l_parallel_wrist_mount_block/>
    </xacro:if>
  </xacro:macro>
  <!-- End-effector payload plus the parallel mount block; identical across wrist versions. -->
  <xacro:macro name="igris_c_r_wrist_payload_block">
    <xacro:if value="${end_effector_value == 'none'}">
      <xacro:igris_c_no_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'hand'}">
      <xacro:igris_c_r_hand_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == 'magnet'}">
      <xacro:igris_c_r_magnet_end_effector_block/>
    </xacro:if>
    <xacro:if value="${end_effector_value == '1dof'}">
      <xacro:igris_c_r_1dof_gripper_end_effector_block/>
    </xacro:if>
    <xacro:if value="${parallel}">
      <xacro:igris_c_r_parallel_wrist_mount_block/>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="igris_c_lowerarm_module" params="side parallel">
    <xacro:if value="${side == 'left'}">
      <body name="l_forearm" pos="-0.01 0 -0.05" quat="1 0 0 0">
        <joint name="l_wrist_yaw" type="hinge" ref="0.0" class="actuator_8" range="-1.570796327 1.570796327" axis="0 0 1"/>
        <joint name="l_wrist_yaw_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 0 1"/>
        <inertial pos="0.01024 -0.00369 -0.11953" mass="2.428" fullinertia="0.00919 0.00944 0.00179 0.00002 -0.00063 -0.00017"/>
        <geom name="l_forearm_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="l_forearm" class="collision"/>
        <geom name="l_forearm_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_forearm" class="visual"/>
        <xacro:if value="${end_effector_value == 'hand'}">
        </xacro:if>
        <xacro:if value="${end_effector_value == 'dummy'}">
          <body name="l_hand_dummy" pos="0 0 0" quat="1 0 0 0">
            <inertial pos="0.0091 0.00219 -0.34189" mass="0.150" fullinertia="0.00081 0.00117 0.00042 0.00004 -0.00012 0.00005"/>
            <geom name="l_hand_dummy_collision" pos="0 0.0109 -0.3" quat="1 0 0 0" type="sphere" size="0.05" density="0" class="collision"/>
            <geom name="l_hand_dummy_visual" pos="0 0.0109 -0.3" quat="1 0 0 0" type="sphere" size="0.05" material="random" class="visual"/>
          </body>
        </xacro:if>
        <xacro:if value="${parallel}">
          <xacro:igris_c_l_parallel_wrist_forearm_block/>
        </xacro:if>
        <!-- The roll/pitch output chain has the same element structure in both versions, so the
             whole chain is duplicated and the shared payload lives in a macro. -->
        <xacro:if value="${wrist_version_value == 'v2'}">
          <body name="l_wrist_coupler" pos="0 -0.005 -0.2395" quat="1 0 0 0">
            <xacro:if value="${parallel}">
              <joint name="l_wrist_roll" type="hinge" ref="0.0" class="passive" range="-1.483529864 0.837758041" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="l_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:if>
            <xacro:unless value="${parallel}">
              <joint name="l_wrist_roll" type="hinge" ref="0.0" class="actuator_8" range="-1.483529864 0.837758041" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="l_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:unless>
            <inertial pos="-0.00000001709 0.009783 -0.006545" mass="0.032863" fullinertia="0.000004514218 0.00000832556 0.000009474258 0.000000000013 -0.000000000013 0.000000942445"/>
            <geom name="l_wrist_coupler_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_coupler_v2" class="visual"/>
            <body name="l_wrist_mount" pos="0 0 -0.0105" quat="1 0 0 0">
              <xacro:if value="${parallel}">
                <joint name="l_wrist_pitch" type="hinge" ref="0.0" class="passive" range="-0.5759586532 0.5759586532" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="l_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:if>
              <xacro:unless value="${parallel}">
                <joint name="l_wrist_pitch" type="hinge" ref="0.0" class="actuator_8" range="-0.5759586532 0.5759586532" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="l_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:unless>
              <inertial pos="0.000000007648 0.015805 -0.02495" mass="0.058869" fullinertia="0.000014915696 0.000015860639 0.000006306108 -0.000000000004 -0.000000000004 -0.000001893388"/>
              <geom name="l_wrist_mount_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_mount_v2" class="visual"/>
              <xacro:igris_c_l_wrist_payload_block/>
            </body>
          </body>
        </xacro:if>
        <xacro:unless value="${wrist_version_value == 'v2'}">
          <body name="l_wrist_coupler" pos="0 -0.005 -0.2395" quat="1 0 0 0">
            <xacro:if value="${parallel}">
              <joint name="l_wrist_roll" type="hinge" ref="0.0" class="passive" range="-1.483529864 0.959931089" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="l_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:if>
            <xacro:unless value="${parallel}">
              <joint name="l_wrist_roll" type="hinge" ref="0.0" class="actuator_8" range="-1.483529864 0.959931089" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="l_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:unless>
            <inertial pos="0 0.00604 0.00031" mass="0.012" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
            <geom name="l_wrist_coupler_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_coupler_v1" class="visual"/>
            <body name="l_wrist_mount" pos="0 0 0" quat="1 0 0 0">
              <xacro:if value="${parallel}">
                <joint name="l_wrist_pitch" type="hinge" ref="0.0" class="passive" range="-0.698131701 0.698131701" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="l_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:if>
              <xacro:unless value="${parallel}">
                <joint name="l_wrist_pitch" type="hinge" ref="0.0" class="actuator_8" range="-0.698131701 0.698131701" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="l_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:unless>
              <inertial pos="0 0.01203 -0.02699" mass="0.032" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
              <geom name="l_wrist_mount_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="l_wrist_mount_v1" class="visual"/>
              <xacro:igris_c_l_wrist_payload_block/>
            </body>
          </body>
        </xacro:unless>
      </body>
    </xacro:if>
    <xacro:if value="${side == 'right'}">
      <body name="r_forearm" pos="-0.01 0 -0.05" quat="1 0 0 0">
        <joint name="r_wrist_yaw" type="hinge" ref="0.0" class="actuator_8" range="-1.570796327 1.570796327" axis="0 0 1"/>
        <joint name="r_wrist_yaw_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 0 1"/>
        <inertial pos="0.01024 0.00369 -0.11953" mass="2.428" fullinertia="0.00919 0.00944 0.00179 -0.00002 -0.00063 0.00017"/>
        <geom name="r_forearm_collision" pos="0 0 0" quat="1 0 0 0" type="mesh" mesh="r_forearm" class="collision"/>
        <geom name="r_forearm_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_forearm" class="visual"/>
        <xacro:if value="${end_effector_value == 'dummy'}">
          <body name="r_hand_dummy" pos="0 0 0" quat="1 0 0 0">
            <inertial pos="0.0091 -0.00219 -0.34189" mass="0.150" fullinertia="0.00081 0.00117 0.00042 -0.00004 -0.00012 -0.00005"/>
            <geom name="r_hand_dummy_collision" pos="0 -0.0109 -0.3" quat="1 0 0 0" type="sphere" size="0.05" density="0" class="collision"/>
            <geom name="r_hand_dummy_visual" pos="0 -0.0109 -0.3" quat="1 0 0 0" type="sphere" size="0.05" material="random" class="visual"/>
          </body>
        </xacro:if>
        <xacro:if value="${parallel}">
          <xacro:igris_c_r_parallel_wrist_forearm_block/>
        </xacro:if>
        <!-- The roll/pitch output chain has the same element structure in both versions, so the
             whole chain is duplicated and the shared payload lives in a macro. -->
        <xacro:if value="${wrist_version_value == 'v2'}">
          <body name="r_wrist_coupler" pos="0 0.005 -0.2395" quat="1 0 0 0">
            <xacro:if value="${parallel}">
              <joint name="r_wrist_roll" type="hinge" ref="0.0" class="passive" range="-0.837758041 1.483529864" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="r_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:if>
            <xacro:unless value="${parallel}">
              <joint name="r_wrist_roll" type="hinge" ref="0.0" class="actuator_8" range="-0.837758041 1.483529864" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="r_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:unless>
            <inertial pos="-0.00000001709 -0.009783 -0.006545" mass="0.032863" fullinertia="0.000004514218 0.00000832556 0.000009474258 -0.000000000013 -0.000000000013 -0.000000942445"/>
            <geom name="r_wrist_coupler_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_wrist_coupler_v2" class="visual"/>
            <body name="r_wrist_mount" pos="0 0 -0.0105" quat="1 0 0 0">
              <xacro:if value="${parallel}">
                <joint name="r_wrist_pitch" type="hinge" ref="0.0" class="passive" range="-0.5759586532 0.5759586532" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="r_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:if>
              <xacro:unless value="${parallel}">
                <joint name="r_wrist_pitch" type="hinge" ref="0.0" class="actuator_8" range="-0.5759586532 0.5759586532" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="r_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:unless>
              <inertial pos="0.000000007648 -0.015805 -0.02495" mass="0.058869" fullinertia="0.000014915696 0.000015860639 0.000006306108 0.000000000004 -0.000000000004 0.000001893388"/>
              <geom name="r_wrist_mount_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_wrist_mount_v2" class="visual"/>
              <xacro:igris_c_r_wrist_payload_block/>
            </body>
          </body>
        </xacro:if>
        <xacro:unless value="${wrist_version_value == 'v2'}">
          <body name="r_wrist_coupler" pos="0 0.005 -0.2395" quat="1 0 0 0">
            <xacro:if value="${parallel}">
              <joint name="r_wrist_roll" type="hinge" ref="0.0" class="passive" range="-0.959931089 1.483529864" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="r_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:if>
            <xacro:unless value="${parallel}">
              <joint name="r_wrist_roll" type="hinge" ref="0.0" class="actuator_8" range="-0.959931089 1.483529864" limited="true" axis="1 0 0" solreflimit="0.002 1"/>
              <joint name="r_wrist_roll_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="1 0 0"/>
            </xacro:unless>
            <inertial pos="0 -0.00604 0.00031" mass="0.012" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
            <geom name="r_wrist_coupler_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_wrist_coupler_v1" class="visual"/>
            <body name="r_wrist_mount" pos="0 0 0" quat="1 0 0 0">
              <xacro:if value="${parallel}">
                <joint name="r_wrist_pitch" type="hinge" ref="0.0" class="passive" range="-0.698131701 0.698131701" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="r_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:if>
              <xacro:unless value="${parallel}">
                <joint name="r_wrist_pitch" type="hinge" ref="0.0" class="actuator_8" range="-0.698131701 0.698131701" limited="true" axis="0 1 0" solreflimit="0.002 1"/>
                <joint name="r_wrist_pitch_backlash" type="hinge" ref="0.0" class="slack" range="-0.01 0.01" axis="0 1 0"/>
              </xacro:unless>
              <inertial pos="0 -0.01203 -0.02699" mass="0.032" fullinertia="0.00001 0.00001 0.00001 0 0 0"/>
              <geom name="r_wrist_mount_visual" pos="0 0 0" quat="1 0 0 0" material="random" type="mesh" mesh="r_wrist_mount_v1" class="visual"/>
              <xacro:igris_c_r_wrist_payload_block/>
